# LinFan - Code-Konventionen (von `dotnet format` erzwungen)
# Top-level config:
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
max_line_length = 100

# --- Lizenz-Header (SPDX): IDE0073 als Warning → vom CI-quality-Gate erzwungen,
#     `dotnet format` fügt ihn in neuen Dateien automatisch ein ---
file_header_template = SPDX-License-Identifier: GPL-3.0-or-later
dotnet_diagnostic.IDE0073.severity = warning

# --- Sprache / Modernität ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# --- Null-Sicherheit / Qualität ---
dotnet_diagnostic.CS8600.severity = warning   # Nullable-Verstöße sichtbar machen
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8625.severity = warning

# --- Naming: Interfaces mit I-Präfix ---
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

# --- Naming: Konstanten & static readonly = PascalCase ---
# Muss VOR der _-Feld-Regel stehen: 'private const' matcht auch private_field_symbol,
# und Roslyn nimmt die erste passende Regel in Datei-Reihenfolge.
dotnet_naming_rule.const_fields_pascal.severity = warning
dotnet_naming_rule.const_fields_pascal.symbols = const_field_symbol
dotnet_naming_rule.const_fields_pascal.style = pascal_style
dotnet_naming_symbols.const_field_symbol.applicable_kinds = field
dotnet_naming_symbols.const_field_symbol.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_pascal.severity = warning
dotnet_naming_rule.static_readonly_fields_pascal.symbols = static_readonly_field_symbol
dotnet_naming_rule.static_readonly_fields_pascal.style = pascal_style
dotnet_naming_symbols.static_readonly_field_symbol.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field_symbol.required_modifiers = static,readonly

# --- Naming: private Felder _camelCase ---
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# --- Naming: Typen/Methoden/Properties PascalCase ---
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_rule.types_pascal.symbols = type_and_member_symbol
dotnet_naming_rule.types_pascal.style = pascal_style
dotnet_naming_symbols.type_and_member_symbol.applicable_kinds = class,struct,enum,property,method,event
dotnet_naming_style.pascal_style.capitalization = pascal_case

# XAML / Markup
[*.{axaml,xaml}]
indent_size = 2

# Daten / Doku
[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false   # Markdown: 2 Leerzeichen = Zeilenumbruch
