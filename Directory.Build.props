<Project>

  <!--
    Gilt für alle Projekte. Wir zielen weiterhin auf net8.0 (LTS, Konventionen in AGENTS.md),
    erlauben aber das Ausführen auf einer neueren Major-Runtime (z. B. .NET 10), falls keine
    net8-Runtime installiert ist. Build funktioniert mit SDK 8 oder 10.
  -->
  <PropertyGroup>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!--
    The restore audit checks transitive packages too, not only direct ones (the net8 default): a vulnerable package
    pulled in by a test framework or a library is otherwise never reported.
  -->
  <PropertyGroup>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!--
    The version of every build without a release tag: the NEXT version with '-dev'. A release passes
    -p:Version=X.Y.Z from the git tag instead. Raise it after each release - the GUI shows it and the
    update check compares against it, so a lower value calls dev builds older than the release.
    AssemblyInformationalVersion becomes "X.Y.Z+<commit>"; the update check ignores the part after '+'.
  -->
  <PropertyGroup>
    <Version>0.5.0-dev</Version>
  </PropertyGroup>

</Project>
