[Desktop Entry]
Type=Application
Name=LinFan
GenericName=Fan control
Comment=Fan curves, live temperatures and speeds (connects to the LinFan daemon)
# The wrapper is generated by install.sh and pins the dotnet runtime used at install time
# (works around the snap-dotnet issue with Skia).
Exec=/opt/linfan/linfan-gui
# Resolved from the hicolor theme; the installers place linfan-icon.svg as
# /usr/share/icons/hicolor/scalable/apps/linfan.svg.
Icon=linfan
Terminal=false
Categories=System;Settings;HardwareSettings;
Keywords=fan;cooling;pwm;temperature;
