#!/bin/sh
# Pre-remove: stop and disable the service before its files go away (fans ramp back to hardware auto).
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop linfan-daemon.service 2>/dev/null || true
      systemctl disable linfan-daemon.service 2>/dev/null || true
    fi
    ;;
esac

exit 0
