<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LinFan.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LinFan.App/Icons.axaml" />
                <ResourceInclude Source="avares://LinFan.App/Theme/SemanticColors.axaml" />
                <ResourceInclude Source="avares://LinFan.App/Theme/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <!-- Standard-Controls (Tab-Unterstrich, ToggleSwitch, CheckBox, Slider, Combo-/ListBox-Auswahl)
             auf die App-Accent ziehen: ohne Palette nutzt FluentTheme seinen Default-Akzent (hier Orange).
             Avalonia leitet Hover/Pressed-Abstufungen automatisch aus Accent ab. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#38BDF8" />
                <ColorPaletteResources x:Key="Light" Accent="#0284C7" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://LinFan.App/Theme/Layout.axaml" />
    </Application.Styles>
</Application>
