<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:LinFan.App.Localization"
        x:Class="LinFan.App.Views.ConfirmDialog"
        Icon="/Assets/icon.png"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{DynamicResource BgWindow}">
    <!-- „danger" für den Bestätigungs-Button kommt aus Theme/Layout.axaml (app-weit, siehe ConfirmDialog-ctor). -->
    <StackPanel Margin="24" Spacing="{StaticResource SpacingXl}">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource SpacingMd}">
            <!-- Abbrechen ist der sichere Default (Esc / Fenster-X) → keine destruktive Aktion versehentlich. -->
            <Button x:Name="CancelButton" Content="{l:Tr ConfirmDialog.Cancel}" Click="OnCancel" IsCancel="True" />
            <Button x:Name="ConfirmButton" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
