<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LinFan.App.Controllers"
        xmlns:l="clr-namespace:LinFan.App.Localization"
        xmlns:ctrl="clr-namespace:LinFan.App.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:lconv="using:LinFan.App.Converters"
        xmlns:sys="using:System"
        xmlns:svc="using:LinFan.App.Services"
        x:Class="LinFan.App.Views.MainWindow"
        x:DataType="c:MainController"
        Width="1000" Height="720"
        MinWidth="760" MinHeight="520"
        Title="LinFan"
        Icon="/Assets/icon.png"
        Focusable="True"
        Background="{DynamicResource BgWindow}">

    <Window.Resources>

        <!-- An area tab in the header (ListBox.navTabs): text-like, the selected one in the text colour with an accent bar
             along the bottom that sits on the header's divider. Announced as a tab. -->
        <ControlTheme x:Key="NavTabItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="{StaticResource NavTabFontSize}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="{StaticResource NavTabHeight}" />
            <Setter Property="AutomationProperties.ControlTypeOverride" Value="TabItem" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center" />
                        <Border Name="PART_SelectedPipe" Height="3" CornerRadius="{DynamicResource RadiusXxs}" Margin="12,0"
                                VerticalAlignment="Bottom" Background="Transparent" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
                <Setter Property="Background" Value="{DynamicResource Accent}" />
            </Style>
        </ControlTheme>

        <!-- Entries of the header's profile menu (ProfileMenuEntry): a disabled heading, the profiles as radio items (the
             running one checked), a separator, the actions. The look of each comes from ProfileMenuEntryTemplate; the
             separator gets the line instead of the item template (its Kind travels in Tag for the selector). -->
        <ControlTheme x:Key="ProfileMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="c:ProfileMenuEntry">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="Tag" Value="{Binding Kind}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToggleType" Value="{Binding IsProfile, Converter={x:Static lconv:RadioToggleConverter.Instance}}" />
            <Setter Property="IsChecked" Value="{Binding IsRunning, Mode=OneWay}" />
            <Setter Property="ToolTip.Tip" Value="{Binding Tooltip}" />
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Style Selector="^[Tag=Separator]">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Separator />
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>
        <DataTemplate x:Key="ProfileMenuEntryTemplate" x:DataType="c:ProfileMenuEntry">
            <Panel>
                <TextBlock Classes="menuHeading" Text="{Binding Name}" IsVisible="{Binding IsHeading}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingMd}" IsVisible="{Binding IsProfile}">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Ellipse Grid.Column="1" Classes="dirtyDot" IsVisible="{Binding IsDirty}" ToolTip.Tip="{l:Tr DirtyDot.Tooltip}" />
                    <Border Grid.Column="2" Classes="runningBadge" IsVisible="{Binding IsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Classes="profDot small"
                                     Classes.running="{Binding Dot, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Running}"
                                     Classes.dryRun="{Binding Dot, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=DryRun}"
                                     Classes.offline="{Binding Dot, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Offline}" />
                            <TextBlock Text="{l:Tr ProfileMenu.Running}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}" IsVisible="{Binding IsAction}">
                    <PathIcon Data="{Binding IconKey, Converter={x:Static lconv:ResourceKeyConverter.Instance}}" Width="14" Height="14"
                              Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Panel>
        </DataTemplate>

        <!-- A miniature window for the theme tiles, drawn with the tokens of the ThemeVariantScope around it - colours,
             corners, the card frame and the accent (a chosen accent colour included). -->
        <DataTemplate x:Key="ThemePreviewPane" x:DataType="c:ThemeOption">
            <Panel Background="{DynamicResource BgWindow}">
                <Grid Margin="8" RowDefinitions="6,8,*">
                    <Grid ColumnDefinitions="34*,66*">
                        <Border Background="{DynamicResource TextPrimary}" Opacity="0.75" CornerRadius="{DynamicResource RadiusXs}" />
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="{DynamicResource RadiusSm}" Padding="8,10"
                            BorderThickness="1" BorderBrush="{DynamicResource CardOutline}">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="30*,70*" Height="6">
                                <Border Background="{DynamicResource Accent}" CornerRadius="{DynamicResource RadiusXs}" />
                            </Grid>
                            <Grid ColumnDefinitions="52*,48*" Height="4">
                                <Border Background="{DynamicResource Divider}" CornerRadius="{DynamicResource RadiusXxs}" />
                            </Grid>
                            <Grid ColumnDefinitions="40*,60*" Height="4">
                                <Border Background="{DynamicResource Divider}" CornerRadius="{DynamicResource RadiusXxs}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Panel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>

        <!-- ===== Header: wordmark | area tabs | profile button + gear, above a divider ===== -->
        <Style Selector="Border.appBar">
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Border.appBar StackPanel.brand, Border.appBar StackPanel.actions">
            <Setter Property="Margin" Value="0,6,0,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The tabs stand on the divider: their accent bar covers it (the -1 bottom margin). -->
        <Style Selector="ListBox.navTabs">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,-1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <!-- The overview's hint counter: orange with dark text, red while a hint is critical. The dark text is the same in
             both themes (on the orange it reads in either). -->
        <Style Selector="Border.navBadge">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Warning}" />
        </Style>
        <Style Selector="Border.navBadge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#18181B" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.navBadge.critical">
            <Setter Property="Background" Value="{DynamicResource DangerFill}" />
        </Style>
        <Style Selector="Border.navBadge.critical TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnDanger}" />
        </Style>
        <!-- Narrow window (below 860 px = 812 px in the bar, the window's margins off): the tabs take a row of their own. -->
        <ContainerQuery Name="appBar" Query="max-width:812">
            <Style Selector="ListBox.navTabs">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </Style>
            <Style Selector="ListBox.navTabs ListBoxItem">
                <Setter Property="Height" Value="{StaticResource NavTabHeightNarrow}" />
            </Style>
        </ContainerQuery>
        <!-- The running profile: a status dot, a small caption, the name; it opens the profile menu. -->
        <Style Selector="Button.profBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="Padding" Value="12,4,10,4" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.profBtn /template/ ContentPresenter, Button.profBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.profBtn:pointerover /template/ ContentPresenter, Button.profBtn:flyout-open /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHover}" />
        </Style>
        <Style Selector="Button.profBtn TextBlock.profCaption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Button.profBtn TextBlock.profName">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Ellipse.profDot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Ellipse.profDot.small">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
        </Style>
        <Style Selector="Ellipse.profDot.running">
            <Setter Property="Fill" Value="{DynamicResource Success}" />
        </Style>
        <Style Selector="Ellipse.profDot.dryRun">
            <Setter Property="Fill" Value="{DynamicResource InfoAccent}" />
        </Style>
        <Style Selector="Ellipse.profDot.offline">
            <Setter Property="Fill" Value="{DynamicResource DangerAccent}" />
        </Style>
        <!-- The settings gear: in the accent colour while the settings are open; a dot while they hold unsaved changes. -->
        <Style Selector="Button.gearBtn">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.gearBtn /template/ ContentPresenter, Button.gearBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.gearBtn:pointerover /template/ ContentPresenter, Button.gearBtn.current /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHover}" />
        </Style>
        <Style Selector="Button.gearBtn PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.gearBtn.current PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <!-- The profile menu: a faint heading, roomy entries, the running profile checked in the accent colour. -->
        <Style Selector="MenuFlyoutPresenter.profileMenu">
            <Setter Property="MinWidth" Value="300" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.profileMenu MenuItem">
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.profileMenu TextBlock.menuHeading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter.profileMenu MenuItem:checked:radio /template/ ContentControl#PART_ToggleIconPresenter">
            <Setter Property="Content">
                <Template>
                    <PathIcon Data="{StaticResource IconCheck}" Width="16" Height="16" Foreground="{DynamicResource Accent}" />
                </Template>
            </Setter>
        </Style>
        <!-- The tab control only hosts the selected area: the header's tabs and gear are its navigation. -->
        <Style Selector="TabControl.hostOnly /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Borderloser Icon-Button (z. B. Augen-Toggle für die Dashboard-Sichtbarkeit im Geräte-Tab). -->
        <Style Selector="Button.iconBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
        </Style>
        <!-- Disabled (undo/redo with nothing to step to): no grey plate, the dimmed symbol says enough. -->
        <Style Selector="Button.iconBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- While the unsaved-changes bar floats over the bottom of the tabs, every scrollable area (class barInset)
             gets room below its content, so its last rows can be scrolled out from under the bar - nothing shifts
             when the bar appears. 128 = the bar at the narrowest window (title plus up to four wrapped lines) plus
             its bottom margin. -->
        <Style Selector="TabControl.unsaved ScrollViewer.barInset > :is(Control)">
            <Setter Property="Margin" Value="0,0,0,128" />
        </Style>
        <Style Selector="TabControl.unsaved ListBox.barInset">
            <Setter Property="Padding" Value="0,0,0,128" />
        </Style>

        <!-- Flacher, randloser Aufklapp-Header (Lüfter-„Erweitert"): kein Karten-Kasten, volle Breite,
             nur ein Trennstrich unter dem Titel (am Inhalt). Der Chevron klappt beim Aufklappen um. -->
        <Style Selector="ToggleButton.advHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ToggleButton.advHeader:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.advHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.advHeader:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Deliberately NO RenderTransformOrigin here: Avalonia parses "0.5,0.5" as 0.5 PIXELS from the
             top-left (relative units need "50%,50%"), so the icon used to turn around its own corner, swing
             out of the header row and get clipped. The default already is the centre - see
             ChevronTransformTests. Duration and easing match the panel below (ctrl:Collapsible); without
             the easing the icon moved at a constant speed and stopped dead while the panel still settled. -->
        <Style Selector="ToggleButton.advHeader PathIcon.chevron">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Flip, not spin: an 11px icon sweeps 11·√2 ≈ 15.6px while rotating, but the header row is 14px
             tall and the ToggleButton clips its content. scaleY never leaves the icon's own box. -->
        <Style Selector="ToggleButton.advHeader:checked PathIcon.chevron">
            <Setter Property="RenderTransform" Value="scaleY(-1)" />
        </Style>

        <!-- Large live speed beside the test slider (fan › Advanced › Test): accent while the fan runs by hand. -->
        <Style Selector="TextBlock.testRpm">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.testRpm.manual">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Randloses Eingabefeld für die Geräte-Listen: liest sich im Ruhezustand als Text,
             zeigt Inset-Füllung erst bei Hover und Akzent-Rahmen erst bei Fokus (kein Box-in-Box). -->
        <Style Selector="TextBox.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style Selector="TextBox.ghost /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.ghost:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
        </Style>
        <Style Selector="TextBox.ghost:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>


        <!-- Settings lists: a row that is being dragged, a group just created, the airflow direction of a position. -->
        <Style Selector="Border.deviceRow.dragged">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.groupSection.highlight">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBlock.positionName">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}" />
        </Style>
        <Style Selector="TextBlock.positionName.unspecified">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="PathIcon.flow">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintest}" />
        </Style>
        <Style Selector="PathIcon.flow.intake">
            <Setter Property="Foreground" Value="{DynamicResource IntakeBrush}" />
        </Style>
        <Style Selector="PathIcon.flow.exhaust">
            <Setter Property="Foreground" Value="{DynamicResource ExhaustBrush}" />
        </Style>
        <Style Selector="PathIcon.flow.internal">
            <Setter Property="Foreground" Value="{DynamicResource InternalBrush}" />
        </Style>

        <!-- Navigations-Liste (Einstellungen-Sidebar UND Kurvenliste teilen dieselbe Optik):
             Akzent-Streifen links + abgesetzter Hintergrund + Akzent-Text auf dem aktiven Eintrag;
             die stock ListBoxItem-Chrome wird neutralisiert (Markierung sitzt auf Border.menuRow). -->
        <Style Selector="ListBox.navList ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.navList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.navList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.navList Border.menuRow">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        </Style>
        <Style Selector="ListBox.navList ListBoxItem:pointerover Border.menuRow">
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
        </Style>
        <!-- In the curves tab exactly one row carries the mark - the one whose editor is open on the right; which
             profile a curve belongs to shows by its indent below the expanded profile. -->
        <Style Selector="ListBox.navList ListBoxItem:selected Border.menuRow">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}" />
        </Style>
        <Style Selector="ListBox.navList ListBoxItem:selected Border.selBar">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ListBox.navList ListBoxItem:selected Border.menuRow PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ListBox.navList ListBoxItem:selected Border.menuRow TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Curves tab side menu: profile rows with a chevron (collapsed ones point right) and the
             „Läuft“ pill; the selected profile's curves and the "add curve" row hang below it, indented along a
             guide line. These rules follow the navList ones on purpose: the pill and the chevron keep their own
             colours on the highlighted row. -->
        <Style Selector="PathIcon.navChevron">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>
        <Style Selector="PathIcon.navChevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="Border.runningBadge">
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
            <Setter Property="Padding" Value="6,1,8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.runningBadge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Border.navTreeChild">
            <Setter Property="Margin" Value="22,0,0,0" />
            <Setter Property="Padding" Value="6,1,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <!-- "Add curve": a borderless button over the whole row (no hover plate of its own) with a quiet chip inside. -->
        <Style Selector="Button.navAdd">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.navAdd:pointerover /template/ ContentPresenter, Button.navAdd:pressed /template/ ContentPresenter, Button.navAdd:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.navAddChip">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.navAdd:pointerover Border.navAddChip">
            <Setter Property="Background" Value="{DynamicResource ControlHover}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.navAdd:disabled Border.navAddChip">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFaintest}" />
        </Style>
        <!-- Template menu: a faint header line, then entries with a mini preview of the curve. -->
        <Style Selector="TextBlock.templateHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.templatePreview">
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.templatePreview Path">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="StackPanel.templateText">
            <Setter Property="Spacing" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MaxWidth" Value="240" />
        </Style>
        <Style Selector="TextBlock.templateName">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.templateDesc">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Curve editor: outlined source-sensor sections, a check without label for the tri-state headers, the point
             list's frame and the fan blocks (accent border while any fan of the block follows the curve). -->
        <Style Selector="Border.pickSection">
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="CheckBox.triState">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pointList">
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="PathIcon.pointArrow">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>
        <Style Selector="Border.fanBlock">
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Padding" Value="10,2,10,6" />
        </Style>
        <Style Selector="Border.fanBlock.assigned">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.fanBlockHeader">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- ===== Overview ===== -->
        <!-- Offline: the last state stays visible but dimmed; the stamp above says when it is from. The status tile and the
             hints are current (they say that the service is unreachable) and stay as they are. -->
        <Style Selector=":is(Control).frozen">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.frozenStamp">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextHeading}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="TextBlock.sectionSub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <!-- Outlined card on the window background (tiles, hints, loops, fan table). -->
        <Style Selector="Border.ovCard">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.emptyNote">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="TextElement.FontSize" Value="13" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <!-- Status tiles: whole-tile buttons in the card look; the status tile's border follows its level. -->
        <Style Selector="Button.ovTile">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
        </Style>
        <Style Selector="Button.ovTile /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        </Style>
        <Style Selector="Button.ovTile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        </Style>
        <Style Selector="Button.ovTile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}" />
        </Style>
        <!-- Without hints the status tile has nothing to open: no grey plate, it just reads as a tile. -->
        <Style Selector="Button.ovTile:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        </Style>
        <Style Selector="Button.ovTile.notice /template/ ContentPresenter, Button.ovTile.notice:pointerover /template/ ContentPresenter, Button.ovTile.notice:disabled /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
        </Style>
        <Style Selector="Button.ovTile.critical /template/ ContentPresenter, Button.ovTile.critical:pointerover /template/ ContentPresenter, Button.ovTile.critical:disabled /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerAccent}" />
        </Style>
        <Style Selector="TextBlock.tileCaption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.tileValue">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.tileValue.big">
            <Setter Property="FontSize" Value="22" />
        </Style>
        <Style Selector="TextBlock.tileSub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.tileSub.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Ellipse.statusDot">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Success}" />
        </Style>
        <Style Selector="Ellipse.statusDot.notice">
            <Setter Property="Fill" Value="{DynamicResource Warning}" />
        </Style>
        <Style Selector="Ellipse.statusDot.critical">
            <Setter Property="Fill" Value="{DynamicResource DangerAccent}" />
        </Style>
        <!-- Hot (from 80 °C): an icon and bold text besides the colour - the colour alone would not do. -->
        <Style Selector="PathIcon.hotIcon">
            <Setter Property="Data" Value="{StaticResource IconAlertCircle}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerAccent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hot">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.hintRow">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="PathIcon.hintIcon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Data" Value="{StaticResource IconInfo}" />
        </Style>
        <Style Selector="PathIcon.hintIcon.notice">
            <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
            <Setter Property="Data" Value="{StaticResource IconAlert}" />
        </Style>
        <Style Selector="PathIcon.hintIcon.critical">
            <Setter Property="Foreground" Value="{DynamicResource DangerAccent}" />
            <Setter Property="Data" Value="{StaticResource IconAlertCircle}" />
        </Style>
        <Style Selector="Button.hintAction">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Control loops. -->
        <Style Selector="Border.loopRow">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.loopRow.off">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="ToggleSwitch.bare">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <!-- A text-like button (the curve's name opens it). -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter, Button.link:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBlock.loopValue">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="PathIcon.flowArrow">
            <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintest}" />
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.miniCurve">
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.fanChip">
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <!-- Temperature tiles: an opened tile takes its row of the grid. -->
        <Style Selector="ItemsControl.tempTiles > ContentPresenter" x:DataType="c:SensorGroup">
            <Setter Property="ctrl:AutoFillGrid.SpansRow" Value="{Binding IsOpen}" />
        </Style>
        <Style Selector="Button.tempTile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
        </Style>
        <Style Selector="Button.tempTile:pointerover /template/ ContentPresenter, Button.tempTile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}" />
        </Style>
        <Style Selector="PathIcon.tileChevron">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="PathIcon.tileChevron.open">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="ProgressBar.tempBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXxs}" />
            <Setter Property="Background" Value="{DynamicResource ControlTrack}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tempMark">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXxs}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-1,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Border.tileSensor">
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <!-- Fan table. -->
        <Style Selector="Border.fanHeader">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="TextElement.FontSize" Value="11" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Border.fanRow">
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.fanControls">
            <Setter Property="Margin" Value="12,0,12,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Background" Value="{DynamicResource BgInset}" />
        </Style>
        <Style Selector="ProgressBar.meter">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
            <Setter Property="Background" Value="{DynamicResource ControlTrack}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <!-- Manual: the bar in the warning colour - a fixed value is overriding the curve. -->
        <Style Selector="ProgressBar.meter.manual">
            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        </Style>
        <Style Selector="Button.controlChip">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxWidth" Value="220" />
        </Style>
        <Style Selector="Button.controlChip TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
        </Style>
        <Style Selector="TextBlock.controlText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.controlText.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.controlText.accent">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBlock.controlText.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
        </Style>
        <Style Selector="TextBlock.controlText.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerAccent}" />
        </Style>

        <!-- ===== Settings › Darstellung: theme tiles ===== -->
        <Style Selector="ListBox.themeGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.themeGrid ListBoxItem" x:DataType="c:ThemeOption">
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
        </Style>
        <Style Selector="ListBox.themeGrid ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
        </Style>
        <Style Selector="ListBox.themeGrid ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCardAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        </Style>
        <Style Selector="ListBox.themeGrid ListBoxItem:selected /template/ ContentPresenter, ListBox.themeGrid ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.themeGrid ListBoxItem:selected:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.themePreview">
            <Setter Property="Height" Value="86" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Panel.themeRadio">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Panel.themeRadio Ellipse.ring">
            <Setter Property="Stroke" Value="{DynamicResource TextFaint}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Panel.themeRadio Ellipse.dot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.themeGrid ListBoxItem:selected Panel.themeRadio Ellipse.ring">
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ListBox.themeGrid ListBoxItem:selected Panel.themeRadio Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource Accent}" />
        </Style>

        <!-- ===== Settings › Darstellung: accent colour ===== -->
        <!-- The colour dots: a flat list (a ring around the chosen dot instead of a selection plate). -->
        <Style Selector="ListBox.accentSwatches">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.accentSwatches ListBoxItem">
            <Setter Property="Width" Value="76" />
            <Setter Property="Padding" Value="4,8,4,6" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="ListBox.accentSwatches ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.accentSwatches ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHover}" />
        </Style>
        <Style Selector="ListBox.accentSwatches ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.accentSwatches ListBoxItem:selected /template/ ContentPresenter, ListBox.accentSwatches ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Panel.swatch">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Panel.swatch Ellipse.swatchDot, Panel.swatch Ellipse.swatchWheel">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>
        <!-- The chosen dot gets a ring in its own colour, a gap of window colour between. -->
        <Style Selector="Panel.swatch Ellipse.swatchRing">
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.accentSwatches ListBoxItem:selected Panel.swatch Ellipse.swatchRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- "Own colour" shows a colour wheel until it is the chosen one; then its dot is the colour itself. The
             visibility is styles only: a bound IsVisible would be a local value and beat the :selected style. -->
        <Style Selector="Panel.swatch Ellipse.swatchWheel">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Fill">
                <ConicGradientBrush>
                    <GradientStop Offset="0" Color="#F87171" />
                    <GradientStop Offset="0.17" Color="#FBBF24" />
                    <GradientStop Offset="0.33" Color="#34D399" />
                    <GradientStop Offset="0.5" Color="#38BDF8" />
                    <GradientStop Offset="0.67" Color="#818CF8" />
                    <GradientStop Offset="0.83" Color="#F472B6" />
                    <GradientStop Offset="1" Color="#F87171" />
                </ConicGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ListBox.accentSwatches ListBoxItem:not(:selected) Panel.swatch Ellipse.swatchWheel.custom">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TextBlock.swatchName">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.accentCustom">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
        </Style>
        <!-- Hex field: frame like a text field, red while it holds no colour. -->
        <Style Selector="Border.hexField">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Padding" Value="6,0,4,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        </Style>
        <Style Selector="Border.hexField:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.hexField.invalid, Border.hexField.invalid:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerAccent}" />
        </Style>
        <Style Selector="Border.hexSwatch">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.hexInput">
            <Setter Property="Width" Value="84" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.hexInput:pointerover /template/ Border#PART_BorderElement, TextBox.hexInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.accentDerived">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.derivedSwatch">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.accentPreview">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        </Style>
        <!-- Last: the TextBlock rules above (the hint counter, the side menu's rows) would colour their tooltips too. -->
        <StyleInclude Source="avares://LinFan.App/Theme/ToolTipText.axaml" />
    </Window.Styles>

    <!-- Shortcuts (Ctrl+S, Ctrl+Z, Ctrl+Y, Ctrl+Shift+Z) are handled in the code-behind, not as key bindings:
         Avalonia runs the bindings of the focused control's ancestors before the control sees the key, so a text
         box would lose its own Ctrl+Z, and Ctrl+S would save before a field that commits on LostFocus has
         written its value. Esc closing an open dropdown or flyout is built into those controls. -->

    <!-- Rows: header, banners (offline, dry run - a row of their own so a banner pushes the tabs down instead of
         covering them), tabs. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="24">

        <!-- Header: wordmark | areas | the running profile and the settings gear. The areas are the tabs of the content
             below (the tab control only hosts the selected one): ←/→, Home and End move between them while they have the
             focus - the list box does that itself, no window-wide key handler. Below 860 px window width they take a row
             of their own (the ContainerQuery appBar in the styles). The status line that sat under the wordmark is the
             profile button's tooltip now. -->
        <Border Grid.Row="0" Name="AppBar" Classes="appBar" Container.Name="appBar" Container.Sizing="Width">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="28">
                <!-- Wordmark as in Assets/linfan-logo-horizontal.svg: the mark, "Lin" in the text colour,
                     "Fan" in the accent. Sizes and spacing are the SVG's proportions at FontSize 28. -->
                <StackPanel Grid.Column="0" Classes="brand" Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                    <ctrl:BrandMark Height="25" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Lin" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Fan" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                    </StackPanel>
                </StackPanel>

                <!-- No selection while the settings are open (the gear stands for them), hence not AlwaysSelected. -->
                <!-- Grid.Column comes from the navTabs style: the narrow layout moves it, and a local value would win. -->
                <ListBox Name="NavTabs" Classes="navTabs" SelectionMode="Single" WrapSelection="True"
                         SelectedIndex="{Binding NavIndex}" ItemContainerTheme="{StaticResource NavTabItem}"
                         AutomationProperties.Name="{l:Tr Nav.Name}" AutomationProperties.ControlTypeOverride="Tab">
                    <!-- A StackPanel, not a WrapPanel: only its keyboard navigation wraps around (WrapSelection). -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Name="NavOverview" AutomationProperties.Name="{Binding NavOverviewName}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <PathIcon Data="{StaticResource IconPulse}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr MainWindow.TabOverview}" VerticalAlignment="Center" />
                            <!-- The hints that need a look - the ones behind the overview's status tile. -->
                            <Border Name="NavHintBadge" Classes="navBadge" Classes.critical="{Binding NavHintCritical}"
                                    IsVisible="{Binding ShowNavHintBadge}" ToolTip.Tip="{Binding NavHintName}"
                                    AutomationProperties.Name="{Binding NavHintName}">
                                <TextBlock Text="{Binding NavHintCount}" />
                            </Border>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Name="NavCurves" AutomationProperties.Name="{Binding NavCurvesName}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <PathIcon Data="{StaticResource IconChartLine}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr MainWindow.TabCurves}" VerticalAlignment="Center" />
                            <Ellipse Name="CurvesTabDirtyDot" Classes="dirtyDot" IsVisible="{Binding Editor.CurvesAreaDirty}"
                                     ToolTip.Tip="{l:Tr DirtyDot.Tooltip}" AutomationProperties.Name="{l:Tr DirtyDot.Name}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Column="2" Classes="actions" Orientation="Horizontal" Spacing="{StaticResource SpacingLg}">
                    <!-- Never disabled: before the first connection and offline the menu says what is possible. Switching goes
                         through the editor, which asks while changes are unsaved. The menu is rebuilt as it opens. -->
                    <Button Name="ProfileButton" Classes="profBtn" ToolTip.Tip="{Binding ProfileTooltip}"
                            AutomationProperties.Name="{Binding ProfileButtonName}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                            <Ellipse Grid.Column="0" Name="ProfileDotMark" Classes="profDot"
                                     Classes.running="{Binding ProfileDot, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Running}"
                                     Classes.dryRun="{Binding ProfileDot, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=DryRun}"
                                     Classes.offline="{Binding ProfileDot, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Offline}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="profCaption" Text="{Binding ProfileCaption}" />
                                <TextBlock Name="ProfileButtonText" Classes="profName" Text="{Binding ProfileName}" />
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14"
                                      Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                        </Grid>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="profileMenu"
                                        ItemsSource="{Binding ProfileMenu}" ItemContainerTheme="{StaticResource ProfileMenuItem}"
                                        ItemTemplate="{StaticResource ProfileMenuEntryTemplate}" />
                        </Button.Flyout>
                    </Button>
                    <Button Name="SettingsButton" Classes="gearBtn" Classes.current="{Binding IsSettingsOpen}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{l:Tr MainWindow.TabSettings}" AutomationProperties.Name="{Binding SettingsButtonName}">
                        <Panel>
                            <PathIcon Data="{StaticResource IconCog}" Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Name="SettingsTabDirtyDot" Classes="dirtyDot" Margin="0,7,7,0"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     IsVisible="{Binding Editor.SettingsAreaDirty}"
                                     ToolTip.Tip="{l:Tr DirtyDot.SettingsTooltip}" AutomationProperties.Name="{l:Tr DirtyDot.Name}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connection banners. Neither shows during the first connection attempt, so nothing flashes at start;
             they cannot be closed - they last exactly as long as their cause. -->
        <StackPanel Grid.Row="1">
            <!-- Offline: text per cause (unreachable: the command to check the service; access denied: the group
                 hint, the service runs; unreadable data: another version, the GUI log - without "Reconnect", the
                 connection stands). The title is the live region (role=alert): its text appears together with
                 the banner. The command stays selectable in case the clipboard is not available. -->
            <Border Name="OfflineBanner" Classes="banner danger" IsVisible="{Binding Connection.ShowOfflineBanner}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                    <PathIcon Grid.Column="0" Classes="bannerIcon" Data="{StaticResource IconAlertCircle}" />
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                        <TextBlock Name="OfflineBannerTitle" Classes="bannerTitle" Text="{Binding Connection.OfflineTitle}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Classes="bannerText" Text="{Binding Connection.OfflineText}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}"
                                    IsVisible="{Binding Connection.ShowDiagnosticCommand}">
                            <Border Background="{DynamicResource BgWindow}" CornerRadius="{DynamicResource RadiusSm}"
                                    Padding="8,3" VerticalAlignment="Center">
                                <SelectableTextBlock Name="DiagnosticCommandText" Text="{Binding Connection.DiagnosticCommand}"
                                                     FontFamily="{StaticResource MonoFontFamily}"
                                                     FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <Button Name="CopyDiagnosticButton" Click="OnCopyDiagnosticCommand"
                                    Padding="8,2" MinHeight="0" FontSize="12" VerticalAlignment="Center"
                                    ToolTip.Tip="{l:Tr OfflineBanner.CopyTooltip}"
                                    AutomationProperties.Name="{Binding Connection.CopyLabel}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                    <PathIcon Data="{StaticResource IconCopy}" Width="11" Height="11" />
                                    <TextBlock Text="{Binding Connection.CopyLabel}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Unreadable data: the GUI log with the details, selectable like the command above. -->
                        <Border Background="{DynamicResource BgWindow}" CornerRadius="{DynamicResource RadiusSm}"
                                Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding Connection.ShowErrorLogPath}">
                            <SelectableTextBlock Name="UnreadableLogPathText" Text="{Binding Connection.ErrorLogPath}"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <!-- The button is disabled while its async command runs. Label and note each sit on invisible
                         copies of their longest text, so neither the button nor the column resizes when they change
                         (in both languages); the copies are kept out of the accessibility tree. -->
                    <StackPanel Grid.Column="2" Spacing="{StaticResource SpacingXs}" VerticalAlignment="Center"
                                IsVisible="{Binding Connection.ShowReconnect}">
                        <Button Name="ReconnectButton" Command="{Binding Connection.ReconnectCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="{l:Tr OfflineBanner.ReconnectTooltip}"
                                AutomationProperties.Name="{Binding Connection.ReconnectLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                                <Panel>
                                    <TextBlock Text="{l:Tr OfflineBanner.Reconnect}" Opacity="0"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{l:Tr OfflineBanner.Reconnecting}" Opacity="0"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Name="ReconnectLabel" Text="{Binding Connection.ReconnectLabel}" />
                                </Panel>
                            </StackPanel>
                        </Button>
                        <Panel HorizontalAlignment="Center">
                            <TextBlock Classes="bannerText" Text="{l:Tr OfflineBanner.StillNotConnected}" Opacity="0"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Name="ReconnectFeedback" Classes="bannerText" Text="{Binding Connection.ReconnectFeedback}"
                                       TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </Panel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dry run: the daemon's control loop runs without the rights to write PWM - only while connected. -->
            <Border Name="DryRunBanner" Classes="banner info" IsVisible="{Binding Connection.ShowDryRunBanner}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingMd}">
                    <PathIcon Grid.Column="0" Classes="bannerIcon" Data="{StaticResource IconInfo}" />
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXs}">
                        <TextBlock Classes="bannerTitle" Text="{l:Tr DryRunBanner.Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="bannerText" Text="{l:Tr DryRunBanner.Text}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Only the host of the selected area: for screen readers a pane, not a second (nameless) tab control - the
             header's list is the tab list. -->
        <TabControl Grid.Row="2" Classes="hostOnly" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Classes.unsaved="{Binding Editor.HasUnsavedChanges}" AutomationProperties.ControlTypeOverride="Pane">

            <!-- ============ Tab 1: Live-Übersicht ============ -->
            <TabItem>
                <Grid RowDefinitions="*" Margin="0,14,0,0">

                    <!-- Before the first connection nothing is known - in particular not that there are no sensors. -->
                    <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding OverviewConnecting}">
                        <TextBlock Name="OverviewConnectingText" Text="{l:Tr MainCtrl.ConnectingToService}"
                                   Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- Right inset on a Border (as in the settings): the overlay scroll bar must not cover the tiles' edge. -->
                    <ScrollViewer Name="OverviewScroller" Classes="barInset" IsVisible="{Binding HasLiveData}">
                    <Border Padding="0,0,14,0">
                    <StackPanel Name="OverviewContent" Spacing="{StaticResource SpacingLg}">

                    <!-- Offline: the last known state stays, dimmed below, with the time it is from. -->
                    <Border Name="FrozenStamp" Classes="frozenStamp" IsVisible="{Binding OverviewFrozen}"
                            ToolTip.Tip="{l:Tr Overview.FrozenTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                            <PathIcon Data="{StaticResource IconRestore}" Width="12" Height="12" />
                            <TextBlock Text="{Binding FrozenAtText}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="22">

                    <!-- ============ Status: four tiles, each leading to its detail ============ -->
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <ctrl:AutoFillGrid MinItemWidth="210" Spacing="{StaticResource SpacingLg}">
                            <!-- Toggles the hints - only while there are some (the command says so). -->
                            <Button Name="StatusTile" Classes="ovTile" Command="{Binding ToggleHintsCommand}"
                                    Classes.notice="{Binding StatusIsNotice}" Classes.critical="{Binding StatusIsCritical}"
                                    ToolTip.Tip="{Binding OverviewStatus.Tooltip}"
                                    AutomationProperties.Name="{Binding OverviewStatus.Name}">
                                <StackPanel Spacing="{StaticResource SpacingXs}">
                                    <TextBlock Classes="tileCaption" Text="{l:Tr Overview.Status}" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                        <Ellipse Classes="statusDot" Classes.notice="{Binding StatusIsNotice}"
                                                 Classes.critical="{Binding StatusIsCritical}" />
                                        <!-- The live region is the headline: it changes with the level and the count, not with every value. -->
                                        <TextBlock Name="StatusHeadline" Classes="tileValue" Text="{Binding OverviewStatus.Headline}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <TextBlock Name="StatusDetail" Classes="tileSub" Text="{Binding OverviewStatus.Detail}" />
                                </StackPanel>
                            </Button>
                            <Button Name="HottestTile" Classes="ovTile" Classes.frozen="{Binding OverviewFrozen}" Command="{Binding ShowTemperaturesCommand}"
                                    ToolTip.Tip="{l:Tr Overview.ToTemperatures}" AutomationProperties.Name="{Binding Tiles.HottestTileName}">
                                <StackPanel Spacing="{StaticResource SpacingXs}">
                                    <TextBlock Classes="tileCaption" Text="{l:Tr Overview.HottestSensor}" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                        <PathIcon Classes="hotIcon" Width="16" Height="16" IsVisible="{Binding Tiles.HottestIsHot}"
                                                  ToolTip.Tip="{l:Tr Overview.HotTooltip}" AutomationProperties.Name="{l:Tr Overview.HotName}" />
                                        <TextBlock Classes="tileValue" Text="{Binding Tiles.HottestValue}"
                                                   ctrl:TemperatureColor.Value="{Binding Tiles.HottestTemperature}" />
                                    </StackPanel>
                                    <TextBlock Classes="tileSub" Text="{Binding Tiles.HottestName}" ToolTip.Tip="{Binding Tiles.HottestName}" />
                                </StackPanel>
                            </Button>
                            <Button Name="FansTile" Classes="ovTile" Classes.frozen="{Binding OverviewFrozen}" Command="{Binding ShowFansCommand}"
                                    ToolTip.Tip="{l:Tr Overview.ActionToFans}" AutomationProperties.Name="{Binding Tiles.FanTileName}">
                                <StackPanel Spacing="{StaticResource SpacingXs}">
                                    <TextBlock Classes="tileCaption" Text="{l:Tr MainWindow.Fans}" />
                                    <TextBlock Classes="tileValue" Text="{Binding Tiles.FanHeadline}" />
                                    <TextBlock Classes="tileSub" Text="{Binding Tiles.FanDetail}" ToolTip.Tip="{Binding Tiles.FanDetail}" />
                                </StackPanel>
                            </Button>
                            <Button Name="ProfileTile" Classes="ovTile" Classes.frozen="{Binding OverviewFrozen}" Command="{Binding OpenRunningProfileCommand}"
                                    ToolTip.Tip="{l:Tr Overview.OpenProfile}" AutomationProperties.Name="{Binding Tiles.ProfileTileName}">
                                <StackPanel Spacing="{StaticResource SpacingXs}">
                                    <TextBlock Classes="tileCaption" Text="{l:Tr Overview.ProfileTile}" />
                                    <TextBlock Classes="tileValue" Text="{Binding Tiles.ProfileName}" />
                                    <TextBlock Classes="tileSub" Text="{Binding Tiles.ProfileDetail}" />
                                </StackPanel>
                            </Button>
                        </ctrl:AutoFillGrid>

                        <!-- The hints behind the status tile. -->
                        <Border Name="HintList" Classes="ovCard" IsVisible="{Binding IsHintsOpen}"
                                AutomationProperties.Name="{l:Tr Overview.HintsName}">
                            <ItemsControl ItemsSource="{Binding Hints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="c:OverviewHint">
                                        <Border Classes="hintRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                                                <!-- Shape and colour per severity (info, notice, critical); the text is read out with it. -->
                                                <PathIcon Grid.Column="0" Classes="hintIcon" Classes.critical="{Binding IsCritical}"
                                                          Classes.notice="{Binding IsNotice}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           AutomationProperties.Name="{Binding AccessibleText}" />
                                                <Button Grid.Column="2" Classes="hintAction" IsVisible="{Binding HasAction}"
                                                        Content="{Binding ActionLabel}" Command="{Binding Command}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ============ Control loops: sensor → curve → fans, one row per curve of the running profile ============ -->
                    <StackPanel Spacing="{StaticResource SpacingSm}" Classes.frozen="{Binding OverviewFrozen}">
                        <WrapPanel>
                            <TextBlock Classes="sectionTitle" Text="{l:Tr Overview.Loops}" Margin="0,0,10,0" />
                            <TextBlock Classes="sectionSub" Text="{Binding Tiles.LoopsSubtitle}" />
                        </WrapPanel>
                        <Border Classes="emptyNote" IsVisible="{Binding ShowNoLoops}">
                            <TextBlock Text="{l:Tr Overview.NoLoops}" TextWrapping="Wrap" />
                        </Border>
                        <Border Classes="ovCard" IsVisible="{Binding HasLoops}">
                            <ItemsControl Name="LoopList" ItemsSource="{Binding Loops}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="c:LoopRow">
                                        <Border Classes="loopRow" Classes.off="{Binding !Enabled}">
                                            <ctrl:FlexRow Spacing="16" RowSpacing="10">
                                                <ToggleSwitch Classes="bare" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanToggle}"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="{l:Tr MainWindow.CurveToggleTooltip}" ToolTip.ShowOnDisabled="True"
                                                              AutomationProperties.Name="{Binding SwitchName}" />
                                                <StackPanel ctrl:FlexRow.Basis="170" ctrl:FlexRow.Grow="1" Spacing="2" VerticalAlignment="Center">
                                                    <Button Classes="link" Command="{Binding EditCommand}" Content="{Binding Name}"
                                                            ToolTip.Tip="{l:Tr Overview.LoopEditTooltip}" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource TextFaint}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <!-- Input -->
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMd}" VerticalAlignment="Center"
                                                            Background="Transparent" ToolTip.Tip="{Binding InputTooltip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" MinWidth="64" VerticalAlignment="Center">
                                                        <PathIcon Classes="hotIcon" Width="14" Height="14" IsVisible="{Binding IsHot}"
                                                                  ToolTip.Tip="{l:Tr Overview.HotTooltip}" AutomationProperties.Name="{l:Tr Overview.HotName}" />
                                                        <TextBlock Classes="loopValue" Text="{Binding TemperatureText}"
                                                                   ctrl:TemperatureColor.Value="{Binding Temperature}" />
                                                    </StackPanel>
                                                    <ctrl:Sparkline Values="{Binding History}" Width="80" Height="24" MinHeight="0"
                                                                    VerticalAlignment="Center"
                                                                    ctrl:TemperatureColor.Value="{Binding Temperature}" />
                                                </StackPanel>
                                                <PathIcon Classes="flowArrow" />
                                                <!-- Curve -->
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMd}" VerticalAlignment="Center"
                                                            Background="Transparent" ToolTip.Tip="{l:Tr Overview.LoopOutputTooltip}">
                                                    <Border Classes="miniCurve">
                                                        <ctrl:MiniCurve Width="64" Height="36" Samples="{Binding CurveSamples}"
                                                                        DotTemperature="{Binding DotTemperature}" DotPercent="{Binding OutputPercent}"
                                                                        Stroke="{DynamicResource Accent}">
                                                            <ctrl:MiniCurve.DotFill>
                                                                <SolidColorBrush Color="{DynamicResource LiveColor}" />
                                                            </ctrl:MiniCurve.DotFill>
                                                        </ctrl:MiniCurve>
                                                    </Border>
                                                    <TextBlock Classes="loopValue" Text="{Binding OutputText}" MinWidth="58" />
                                                </StackPanel>
                                                <PathIcon Classes="flowArrow" />
                                                <!-- Fans -->
                                                <ItemsControl ctrl:FlexRow.Basis="200" ctrl:FlexRow.Grow="2" ItemsSource="{Binding Fans}"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="c:FanRow">
                                                            <Border Classes="fanChip" ToolTip.Tip="{Binding ChipTooltip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Name}" />
                                                                    <TextBlock Text="{Binding Rpm}" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ctrl:FlexRow>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <ctrl:FlexRow Spacing="22" RowSpacing="22" Classes.frozen="{Binding OverviewFrozen}">

                    <!-- ============ Temperatures: one tile per group (saved order), highest value large, opens to the sensors ============ -->
                    <StackPanel Name="OverviewTemperatures" ctrl:FlexRow.Basis="340" ctrl:FlexRow.Grow="1"
                                Spacing="{StaticResource SpacingSm}" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMd}">
                            <TextBlock Classes="sectionTitle" Text="{l:Tr MainWindow.Temperatures}" />
                            <TextBlock Classes="sectionSub" Text="{Binding Tiles.SensorCountText}" />
                        </StackPanel>
                        <TextBlock Text="{l:Tr Overview.NoSensors}" Foreground="{DynamicResource TextFaint}"
                                   FontSize="12" IsVisible="{Binding ShowNoSensors}" />
                        <ItemsControl Name="TemperatureTiles" Classes="tempTiles" ItemsSource="{Binding SensorGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctrl:AutoFillGrid MinItemWidth="150" Spacing="{StaticResource SpacingMd}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="c:SensorGroup">
                                    <Border Classes="ovCard" VerticalAlignment="Top">
                                        <StackPanel>
                                            <Button Classes="tempTile" Command="{Binding ToggleCommand}"
                                                    ToolTip.Tip="{l:Tr Overview.TileToggleTooltip}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <StackPanel Spacing="{StaticResource SpacingXs}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="tileCaption" Text="{Binding Name}" />
                                                        <PathIcon Grid.Column="1" Classes="tileChevron" Classes.open="{Binding IsOpen}"
                                                                  Data="{StaticResource IconChevronDown}" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <PathIcon Classes="hotIcon" Width="16" Height="16" IsVisible="{Binding IsHot}"
                                                                  ToolTip.Tip="{l:Tr Overview.HotTooltip}" AutomationProperties.Name="{l:Tr Overview.HotName}" />
                                                        <TextBlock Classes="tileValue big" Text="{Binding MaxDisplay}"
                                                                   ctrl:TemperatureColor.Value="{Binding Max}" />
                                                    </StackPanel>
                                                    <!-- 0-100 °C; the mark sits at the 80 °C warning threshold (80 of 100 columns). -->
                                                    <Grid ColumnDefinitions="80*,20*" ToolTip.Tip="{l:Tr Overview.BarTooltip}" Background="Transparent">
                                                        <ProgressBar Grid.ColumnSpan="2" Classes="tempBar" Minimum="0" Maximum="100"
                                                                     Value="{Binding BarPercent}"
                                                                     ctrl:TemperatureColor.Value="{Binding Max}" />
                                                        <Border Grid.Column="1" Classes="tempMark" />
                                                    </Grid>
                                                    <TextBlock Classes="tileSub small" Text="{Binding Sub}" />
                                                </StackPanel>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Sensors}" IsVisible="{Binding IsOpen}" Margin="14,0,14,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="c:SensorRow">
                                                        <Border Classes="tileSensor">
                                                            <Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}" VerticalAlignment="Center" />
                                                                    <!-- The hardware id only for a duplicate name (empty and hidden otherwise). -->
                                                                    <TextBlock Text="{Binding Disambiguator}" Foreground="{DynamicResource TextFaintest}"
                                                                               FontSize="10" VerticalAlignment="Center"
                                                                               IsVisible="{Binding Disambiguator, Converter={x:Static lconv:StringNotEmptyConverter.Instance}}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <PathIcon Classes="hotIcon" Width="13" Height="13" IsVisible="{Binding IsHot}"
                                                                              ToolTip.Tip="{l:Tr Overview.HotTooltip}" AutomationProperties.Name="{l:Tr Overview.HotName}" />
                                                                    <TextBlock Text="{Binding Display}" Classes.hot="{Binding IsHot}"
                                                                               ctrl:TemperatureColor.Value="{Binding Value}" />
                                                                </StackPanel>
                                                                <ctrl:Sparkline Grid.Column="2" Values="{Binding History}" Height="22" MinHeight="0"
                                                                                VerticalAlignment="Center"
                                                                                ctrl:TemperatureColor.Value="{Binding Value}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============ Fans: a compact table; the controls open in place behind "…" ============ -->
                    <StackPanel Name="OverviewFans" ctrl:FlexRow.Basis="600" ctrl:FlexRow.Grow="1.7"
                                Spacing="{StaticResource SpacingSm}" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMd}">
                            <TextBlock Classes="sectionTitle" Text="{l:Tr MainWindow.Fans}" />
                            <TextBlock Classes="sectionSub" Text="{Binding Tiles.FanCountText}" />
                        </StackPanel>
                        <TextBlock Text="{l:Tr Overview.NoFans}" Foreground="{DynamicResource TextFaint}"
                                   FontSize="12" IsVisible="{Binding ShowNoFans}" />
                        <!-- No horizontal scroller: it would measure the rows unbounded, and each row's star columns would size
                             to their own content (misaligned columns). The section only sits beside the tiles where 600 fit. -->
                        <Border Classes="ovCard" IsVisible="{Binding HasFans}">
                                <StackPanel MinWidth="600">
                                    <Border Classes="fanHeader">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" MinWidth="130" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" MinWidth="130" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{l:Tr Overview.ColFan}" />
                                            <TextBlock Grid.Column="1" Text="{l:Tr Overview.ColPower}" />
                                            <TextBlock Grid.Column="2" Text="{l:Tr Overview.ColSpeed}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{l:Tr Overview.ColHistory}" />
                                            <TextBlock Grid.Column="4" Text="{l:Tr Overview.ColControl}" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl Name="FanTable" ItemsSource="{Binding Fans}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="c:FanRow">
                                                <Border Classes="fanRow" AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel>
                                                        <Grid ColumnSpacing="12" Margin="12,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.3*" MinWidth="130" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" MinWidth="130" />
                                                                <ColumnDefinition Width="36" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FanId}" />
                                                                    <PathIcon Data="{StaticResource IconFan}" Width="12" Height="12"
                                                                              Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                              IsVisible="{Binding IsCalibrating}"
                                                                              ToolTip.Tip="{l:Tr MainWindow.CalibrationRunning}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Grid Grid.Column="1" ColumnDefinitions="*,40" VerticalAlignment="Center">
                                                                <ProgressBar Classes="meter" Classes.manual="{Binding IsManual}"
                                                                             Minimum="0" Maximum="100" Value="{Binding PercentNum}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12" TextAlignment="Right"
                                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center" Spacing="3">
                                                                <TextBlock Text="{Binding RpmNumber}" FontSize="15" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Bottom" />
                                                                <TextBlock Text="{Binding RpmUnit}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                           VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                            </StackPanel>
                                                            <ctrl:Sparkline Grid.Column="3" Values="{Binding RpmHistory}" Height="22" MinHeight="0"
                                                                            VerticalAlignment="Center" Stroke="{DynamicResource Accent}" />
                                                            <Panel Grid.Column="4" VerticalAlignment="Center">
                                                                <Button Classes="chip controlChip" IsVisible="{Binding ControlOpensCurve}"
                                                                        Command="{Binding OpenControlCurveCommand}" ToolTip.Tip="{Binding ControlTooltip}"
                                                                        AutomationProperties.Name="{Binding ControlName}" HorizontalAlignment="Left">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingXs}">
                                                                        <PathIcon Data="{StaticResource IconChartLine}" Width="12" Height="12"
                                                                                  Foreground="{DynamicResource Accent}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding ControlLabel}" TextTrimming="CharacterEllipsis"
                                                                                   Classes.warning="{Binding ControlIsWarning}" />
                                                                    </Grid>
                                                                </Button>
                                                                <TextBlock Classes="controlText" IsVisible="{Binding !ControlOpensCurve}"
                                                                           Text="{Binding ControlLabel}" ToolTip.Tip="{Binding ControlTooltip}"
                                                                           AutomationProperties.Name="{Binding ControlName}"
                                                                           Classes.muted="{Binding ControlIsMuted}" Classes.accent="{Binding ControlIsAccent}"
                                                                           Classes.warning="{Binding ControlIsWarning}" Classes.danger="{Binding ControlIsDanger}" />
                                                            </Panel>
                                                            <Button Grid.Column="5" Classes="iconBtn" Command="{Binding ToggleExpandedCommand}"
                                                                    ToolTip.Tip="{l:Tr Overview.MoreTooltip}"
                                                                    AutomationProperties.Name="{Binding MoreName}">
                                                                <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" />
                                                            </Button>
                                                        </Grid>
                                                        <!-- Opened with "…": manual control, override note, calibration. -->
                                                        <Border Classes="fanControls" IsVisible="{Binding IsExpanded}">
                                                            <StackPanel Spacing="{StaticResource SpacingMd}">
                                                                <Grid ColumnDefinitions="Auto,*,46" IsVisible="{Binding CanControl}">
                                                                    <ToggleSwitch Grid.Column="0" IsChecked="{Binding IsManual}" IsEnabled="{Binding CanOperate}"
                                                                                  OnContent="{l:Tr MainWindow.Manual}" OffContent="{l:Tr MainWindow.Auto}"
                                                                                  Margin="0,0,12,0" MinWidth="0" />
                                                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SliderPercent}"
                                                                            IsEnabled="{Binding CanMoveSlider}" VerticalAlignment="Center"
                                                                            ToolTip.Tip="{l:Tr MainWindow.ManualPowerTooltip}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding SliderPercent, StringFormat='{}{0:0} %'}"
                                                                               Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"
                                                                               TextAlignment="Right" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingSm}"
                                                                      IsVisible="{Binding ShowOverrideNote}">
                                                                    <PathIcon Grid.Column="0" Data="{StaticResource IconAlertCircle}" Width="12" Height="12"
                                                                              Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding OverrideNote}" FontSize="12" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2" Classes="hintAction" Content="{l:Tr Overview.BackToCurve}"
                                                                            Command="{Binding BackToCurveCommand}" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMd}"
                                                                      IsVisible="{Binding CanControl}">
                                                                    <Button Grid.Column="0" Command="{Binding CalibrateCommand}" IsEnabled="{Binding CanCalibrate}"
                                                                            FontSize="12" Padding="8,3"
                                                                            ToolTip.Tip="{Binding CalibrateTooltip}" ToolTip.ShowOnDisabled="True">
                                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                            <PathIcon Data="{StaticResource IconGauge}" Width="12" Height="12" />
                                                                            <TextBlock Text="{l:Tr MainWindow.Calibrate}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <TextBlock Grid.Column="1" Text="{Binding CalibrationState}" FontSize="11"
                                                                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                                                                               ToolTip.Tip="{Binding CalibrationBadgeHint}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Pwm}" FontSize="11"
                                                                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding ReadOnlyNote}" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextFaint}" IsVisible="{Binding IsReadOnly}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                        </Border>
                    </StackPanel>
                    </ctrl:FlexRow>
                    </StackPanel>
                    </StackPanel>
                    </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ Tab 2: Profile & Kurven ============ -->
            <TabItem>
                <!-- Profile and curves are both managed in the side menu below, so this tab no longer needs
                     a bar of its own above the content. -->
                <Grid RowDefinitions="*" Margin="0,12,0,0">

                    <!-- Pre-Load-Hinweis: vor dem ersten Snapshot, Text je nach Verbindungszustand -->
                    <Border Classes="card" IsVisible="{Binding ShowCurveLoading}" VerticalAlignment="Top">
                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap"
                                   Text="{Binding CurveLoadingText}" />
                    </Border>

                    <!-- Verbunden, aber der Daemon meldet keine Geräte → keine Kurven möglich -->
                    <Border Classes="card" IsVisible="{Binding ShowNoDevices}" VerticalAlignment="Top">
                        <TextBlock Foreground="{DynamicResource TextFaint}" FontSize="13" TextWrapping="Wrap"
                                   Text="{l:Tr MainWindow.NoDevicesForCurves}" />
                    </Border>

                    <Grid ColumnDefinitions="240,*" IsVisible="{Binding Editor.IsReady}">

                    <!-- Side menu: every profile and, below the selected one, its curves plus "add curve" - one list with
                         one highlighted row, the one the right-hand side shows (Editor.SelectedNavItem). Selecting a profile
                         only opens it; the one the daemon regulates with carries the „Läuft“ badge. -->
                    <Grid Grid.Column="0" Margin="0,0,14,0" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0" Text="{l:Tr MainWindow.ProfilesAndCurves}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="iconBtn" Command="{Binding Editor.AddProfileCommand}"
                                    ToolTip.Tip="{l:Tr MainWindow.AddProfileTooltip}"
                                    AutomationProperties.Name="{l:Tr MainWindow.AddProfile}">
                                <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"
                                          Foreground="{DynamicResource TextSecondary}" />
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" Name="CurveNavList" Classes="navList barInset" Background="Transparent"
                                 ItemsSource="{Binding Editor.NavItems}" SelectedItem="{Binding Editor.SelectedNavItem, Mode=OneWay}"
                                 SelectionChanged="OnCurveNavSelectionChanged">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="c:ProfileNavItem">
                                    <Border Classes="menuRow" ToolTip.Tip="{Binding Profile.ActivityHint}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                            <Border Grid.Column="0" Classes="selBar" Width="3" Height="16" CornerRadius="{DynamicResource RadiusXxs}"
                                                    Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <!-- Only the selected profile is expanded; the chevron says which. -->
                                            <PathIcon Grid.Column="1" Classes="navChevron" Classes.expanded="{Binding IsExpanded}"
                                                      Data="{StaticResource IconChevronDown}" Width="12" Height="12"
                                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Profile.Name}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Ellipse Grid.Column="3" Classes="dirtyDot" Margin="6,0,0,0" IsVisible="{Binding Profile.IsDirty}"
                                                     ToolTip.Tip="{l:Tr DirtyDot.Tooltip}" AutomationProperties.Name="{l:Tr DirtyDot.Name}" />
                                            <Border Grid.Column="4" Classes="runningBadge" Margin="8,0,0,0" IsVisible="{Binding Profile.IsActive}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{l:Tr MainWindow.ProfileRunning}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="c:CurveNavItem">
                                    <Border Classes="navTreeChild">
                                        <Border Classes="menuRow" Padding="8,6">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                <Border Grid.Column="0" Classes="selBar" Width="3" Height="14" CornerRadius="{DynamicResource RadiusXxs}"
                                                        Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Fill="{Binding Curve.IsActive, Converter={x:Static lconv:BoolToBrushConverter.Instance}, ConverterParameter='#22C55E,#52525B'}"
                                                         ToolTip.Tip="{Binding Curve.ActivityHint}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Curve.Label}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{l:Tr MainWindow.OffParen}" Foreground="{DynamicResource TextFaint}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding !Curve.Enabled}"
                                                           ToolTip.Tip="{l:Tr MainWindow.CurveDisabledTooltip}" />
                                                <Ellipse Grid.Column="4" Classes="dirtyDot" Margin="6,0,0,0" IsVisible="{Binding Curve.IsDirty}"
                                                         ToolTip.Tip="{l:Tr DirtyDot.Tooltip}" AutomationProperties.Name="{l:Tr DirtyDot.Name}" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                                <!-- An action, not a destination: the button covers the whole row, so a click never reaches
                                     the list's selection; from the keyboard, Enter on the row opens the menu (code-behind). -->
                                <DataTemplate DataType="c:AddCurveNavItem">
                                    <Button Classes="navAdd" Name="AddCurveButton"
                                            IsEnabled="{Binding CanAdd}" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowOnDisabled="True"
                                            AutomationProperties.Name="{l:Tr MainWindow.AddCurve}">
                                        <Border Classes="navTreeChild" Padding="6,2,0,8">
                                            <Border Classes="navAddChip">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                    <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
                                                    <TextBlock Text="{l:Tr MainWindow.AddCurve}" />
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                        <Button.Flyout>
                                            <!-- The entries come from CurveTemplates.Menu: an explanatory first line (not
                                                 selectable), then the templates with a mini preview of their points. -->
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding Templates}">
                                                <MenuFlyout.ItemContainerTheme>
                                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                  x:DataType="c:CurveTemplateOption">
                                                        <Setter Property="IsEnabled" Value="{Binding IsTemplate}" />
                                                        <Setter Property="Command"
                                                                Value="{Binding $parent[MenuFlyoutPresenter].((c:AddCurveNavItem)DataContext).AddFromTemplateCommand}" />
                                                        <Setter Property="CommandParameter" Value="{Binding Template}" />
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                                    </ControlTheme>
                                                </MenuFlyout.ItemContainerTheme>
                                                <MenuFlyout.ItemTemplate>
                                                    <DataTemplate x:DataType="c:CurveTemplateOption">
                                                        <Panel>
                                                            <TextBlock Classes="templateHeader" Text="{Binding Name}" IsVisible="{Binding !IsTemplate}" />
                                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsTemplate}">
                                                                <Border Classes="templatePreview">
                                                                    <Path Data="{Binding Points, Converter={x:Static lconv:CurveTemplatePreviewConverter.Instance}}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Classes="templateText">
                                                                    <TextBlock Classes="templateName" Text="{Binding Name}" />
                                                                    <TextBlock Classes="templateDesc" Text="{Binding Description}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Panel>
                                                    </DataTemplate>
                                                </MenuFlyout.ItemTemplate>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </Grid>

                    <!-- Right-hand side: what the side menu marks - a curve or a profile. -->
                    <ScrollViewer Grid.Column="1" Classes="barInset">
                        <StackPanel>
                        <!-- Above both editors while the profile shown is not the running one: what is edited here does not
                             reach the fans until it runs. Activating asks first while changes are unsaved (the daemon would
                             switch to the stored profile, not to the one on screen); offline the tooltip says why it is off. -->
                        <Border Name="InactiveProfileBanner" Classes="banner" Margin="0,0,0,14"
                                IsVisible="{Binding !Editor.SelectedProfileIsActive}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Classes="bannerIcon" Data="{StaticResource IconInfo}" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXxs}" VerticalAlignment="Center">
                                    <TextBlock Classes="bannerTitle" Text="{Binding Editor.EditingInactiveProfileText}" TextWrapping="Wrap" />
                                    <TextBlock Classes="bannerText" Text="{l:Tr MainWindow.InactiveProfileNote}" />
                                </StackPanel>
                                <Button Grid.Column="2" Name="ActivateProfileButton" Margin="12,0,0,0" Padding="10,4" FontSize="12"
                                        VerticalAlignment="Center" Content="{l:Tr MainWindow.ActivateProfile}"
                                        Command="{Binding Editor.ActivateSelectedProfileCommand}"
                                        ToolTip.Tip="{Binding Editor.ActivateProfileHint}" ToolTip.ShowOnDisabled="True" />
                            </Grid>
                        </Border>
                        <Panel>
                        <StackPanel Spacing="{StaticResource SpacingXl}"
                                    IsVisible="{Binding Editor.Pane, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Curve}">

                            <!-- Flach wie die Einstellungen-Sektionen: Titel + Inhalt auf dem Hintergrund, kein Karten-Kasten. -->
                            <Border Classes="card" Background="Transparent">
                                <ContentControl Content="{Binding Editor.SelectedCurve}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="c:CurveEditRow">
                                            <StackPanel Spacing="{StaticResource SpacingLg}">
                                                <!-- Titel + An/Aus-Toggle (live, kein Dirty-Banner). Der Toggle schaltet die
                                                     ausgewählte Kurve über den Controller - Bindung an dessen DataContext (Window-Ahne). -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{l:Tr MainWindow.EditCurve}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center" />
                                                    <!-- Duplicate and delete act on the curve being edited, so they sit with it rather than
                                                         under the list. Their commands live on the editor controller, hence the same
                                                         Window-ancestor binding the toggle uses. Deleting asks nothing: its toast offers
                                                         „Rückgängig". -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpacingSm}"
                                                                VerticalAlignment="Center">
                                                        <Button Padding="8,3" FontSize="11"
                                                                Command="{Binding $parent[Window].((c:MainController)DataContext).Editor.DuplicateCurveCommand}"
                                                                ToolTip.Tip="{l:Tr MainWindow.DuplicateCurveTooltip}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
                                                                <TextBlock Text="{l:Tr MainWindow.Duplicate}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Name="CurveDeleteButton" Classes="danger" Padding="8,3" FontSize="11"
                                                                Command="{Binding $parent[Window].((c:MainController)DataContext).Editor.DeleteCurveCommand}"
                                                                ToolTip.Tip="{l:Tr MainWindow.DeleteCurveTooltip}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12" />
                                                                <TextBlock Text="{l:Tr MainWindow.Delete}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <ToggleSwitch Name="CurveEnabledSwitch" MinWidth="0" Margin="10,0,0,0"
                                                                      OnContent="{l:Tr MainWindow.CurveOn}" OffContent="{l:Tr MainWindow.CurveOff}"
                                                                      IsChecked="{Binding $parent[Window].((c:MainController)DataContext).Editor.SelectedCurveEnabled, Mode=TwoWay}"
                                                                      IsEnabled="{Binding $parent[Window].((c:MainController)DataContext).Editor.IsConnected}"
                                                                      ToolTip.Tip="{l:Tr MainWindow.CurveToggleTooltip}" ToolTip.ShowOnDisabled="True" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Name oben, Graph direkt darunter -->
                                                <!-- Label column 100, not 90: the sensor row below carries an icon
                                                     in front of its label and both grids share the same column width. -->
                                                <Grid ColumnDefinitions="100,*">
                                                    <TextBlock Grid.Column="0" Text="{l:Tr MainWindow.Name}" Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <TextBox Grid.Column="1" Classes="ghost" Text="{Binding Name}"
                                                             FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                </Grid>

                                                <!-- The title keeps its width; the gesture hint gives way (trimmed) in a narrow window. -->
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                                    <TextBlock Grid.Column="0" Text="{l:Tr MainWindow.CurveEditorHint}" Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Bottom" />
                                                    <TextBlock Grid.Column="1" Text="{l:Tr MainWindow.CurveChartGestures}" Foreground="{DynamicResource TextFaint}"
                                                               FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="12,0,0,0"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{l:Tr MainWindow.CurveChartGestures}" />
                                                </Grid>
                                                <!-- Grey bands: the narrowest Min/Max of the controllable fans following the curve.
                                                     Orange band: the hysteresis around the live value. The point rules (at least one,
                                                     at most 128, no duplicate temperature) are the commands' CanExecute. -->
                                                <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource BgInset}" Padding="6">
                                                    <ctrl:CurveChart Name="CurveEditorChart"
                                                                     Points="{Binding Points}"
                                                                     LiveTemperature="{Binding LiveTemperature}"
                                                                     InterpolationMode="{Binding InterpolationMode}"
                                                                     Evaluator="{Binding CurveEvaluator}"
                                                                     LowerLimit="{Binding LowerLimit}" LowerLimitLabel="{Binding LowerLimitLabel}"
                                                                     UpperLimit="{Binding UpperLimit}" UpperLimitLabel="{Binding UpperLimitLabel}"
                                                                     Hysteresis="{Binding Hysteresis}" HysteresisLabel="{Binding HysteresisLabel}"
                                                                     AddPointCommand="{Binding AddPointAtCommand}"
                                                                     Height="240" />
                                                </Border>
                                                <StackPanel Spacing="{StaticResource SpacingXxs}" Margin="0,-6,0,0">
                                                    <TextBlock IsVisible="{Binding HasNoSource}" Foreground="{DynamicResource TextFaint}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Text="{l:Tr MainWindow.NoSourceSensor}" />
                                                    <TextBlock IsVisible="{Binding HasLimits}" Foreground="{DynamicResource TextFaint}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Text="{l:Tr MainWindow.ChartLimitsCaption}" />
                                                    <TextBlock IsVisible="{Binding HasHysteresisBand}" Foreground="{DynamicResource TextFaint}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Text="{l:Tr MainWindow.ChartHysteresisCaption}" />
                                                </StackPanel>

                                                <!-- Settings: source sensors per group, mix (from two sources on), shape, hysteresis, smoothing. -->
                                                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                                    <!-- Same thermometer mark (and the same faint tone) as the sensor rows in the
                                                         settings tab, here labelling the whole block of source sensors. -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                                                Spacing="{StaticResource SpacingXs}" VerticalAlignment="Top" Margin="0,9,12,10">
                                                        <PathIcon Data="{StaticResource IconThermometer}" Width="13" Height="13"
                                                                  Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{l:Tr MainWindow.Sensors}" Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <!-- One section per sensor group (configured order, ungrouped last); the header check
                                                         selects or clears the group, the open state is kept per group by the controller. -->
                                                    <ItemsControl Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                                                  ItemsSource="{Binding $parent[Window].((c:MainController)DataContext).Editor.SourceSensorSections}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="c:SensorCheckGroup">
                                                                <Border Classes="pickSection">
                                                                    <StackPanel>
                                                                        <Grid ColumnDefinitions="Auto,*">
                                                                            <!-- OneWay + command: a click selects all unless all are selected (then
                                                                                 clears) - a plain three-state toggle would clear a partial group. -->
                                                                            <CheckBox Grid.Column="0" Classes="triState"
                                                                                      IsChecked="{Binding AllState, Mode=OneWay}"
                                                                                      Command="{Binding ToggleAllCommand}"
                                                                                      AutomationProperties.Name="{Binding ToggleAllName}"
                                                                                      ToolTip.Tip="{l:Tr MainWindow.SensorGroupToggleTooltip}" />
                                                                            <ToggleButton Grid.Column="1" Classes="advHeader" IsChecked="{Binding IsOpen}"
                                                                                          MinHeight="36" Padding="4,6,0,6"
                                                                                          ToolTip.Tip="{l:Tr MainWindow.SensorGroupOpenTooltip}">
                                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12" Margin="8,0,0,0"
                                                                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <PathIcon Grid.Column="2" Classes="chevron" Data="{StaticResource IconChevronDown}"
                                                                                              Width="11" Height="11" Foreground="{DynamicResource TextFaint}"
                                                                                              VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </ToggleButton>
                                                                        </Grid>
                                                                        <ctrl:Collapsible IsOpen="{Binding IsOpen}">
                                                                            <ItemsControl ItemsSource="{Binding Sensors}" Margin="28,0,0,8">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="c:SensorCheck">
                                                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected}"
                                                                                                      Content="{Binding Sensor.Name}" />
                                                                                            <TextBlock Grid.Column="1" Text="{Binding Sensor.LiveValue}"
                                                                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ctrl:Collapsible>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Mix only matters with two or more sources. -->
                                                    <!-- Switch and note in a WrapPanel: the note moves below the switch when the column is narrow. -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr MainWindow.Mix}" Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Top" Margin="0,9,12,10" IsVisible="{Binding HasMultipleSources}"
                                                               ToolTip.Tip="{l:Tr MainWindow.MixTooltip}" />
                                                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" ItemSpacing="12" LineSpacing="4"
                                                               IsVisible="{Binding HasMultipleSources}">
                                                        <ListBox Name="AggregationSwitch" Classes="seg" SelectionMode="Single,AlwaysSelected"
                                                                 ItemsSource="{Binding Aggregations}" SelectedItem="{Binding SelectedAggregation}"
                                                                 AutomationProperties.Name="{l:Tr MainWindow.Mix}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="c:AggregationOption">
                                                                    <TextBlock Text="{Binding Display}" ToolTip.Tip="{Binding Hint}" />
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock Text="{Binding SelectedAggregation.Summary}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </WrapPanel>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Tr MainWindow.Interpolation}" Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Top" Margin="0,9,12,10"
                                                               ToolTip.Tip="{l:Tr MainWindow.InterpolationTooltip}" />
                                                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" ItemSpacing="12" LineSpacing="4">
                                                        <ListBox Name="InterpolationSwitch" Classes="seg" SelectionMode="Single,AlwaysSelected"
                                                                 ItemsSource="{Binding Interpolations}" SelectedItem="{Binding SelectedInterpolation}"
                                                                 AutomationProperties.Name="{l:Tr MainWindow.Interpolation}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="c:InterpolationOption">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Hint}">
                                                                        <Path Classes="segIcon" Data="{Binding IconKey, Converter={x:Static lconv:ResourceKeyConverter.Instance}}" />
                                                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock Text="{Binding SelectedInterpolation.Summary}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </WrapPanel>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:Tr MainWindow.Hysteresis}" Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Center" Margin="0,0,12,10"
                                                               ToolTip.Tip="{l:Tr MainWindow.HysteresisTooltip}" />
                                                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                                                        <NumericUpDown Grid.Column="0" Theme="{StaticResource Stepper}" Value="{Binding Hysteresis}"
                                                                       Minimum="0" Maximum="20" Increment="0.5" InnerRightContent="°C" Width="120"
                                                                       AutomationProperties.Name="{l:Tr MainWindow.Hysteresis}"
                                                                       ToolTip.Tip="{l:Tr MainWindow.HysteresisTooltip}" />
                                                        <TextBlock Grid.Column="1" Text="{l:Tr MainWindow.HysteresisHint}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                                                                   Margin="12,0,0,0" TextWrapping="Wrap" />
                                                    </Grid>

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:Tr MainWindow.Smoothing}" Foreground="{DynamicResource TextMuted}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                                               ToolTip.Tip="{l:Tr MainWindow.SmoothingTooltip}" />
                                                    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*">
                                                        <NumericUpDown Grid.Column="0" Theme="{StaticResource Stepper}" Value="{Binding SmoothingSeconds}"
                                                                       Minimum="0" Maximum="15" Increment="1" InnerRightContent="s" Width="120"
                                                                       AutomationProperties.Name="{l:Tr MainWindow.Smoothing}"
                                                                       ToolTip.Tip="{l:Tr MainWindow.SmoothingTooltip}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SmoothingHint}" FontSize="12"
                                                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                                                                   Margin="12,0,0,0" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Grid>

                                                <!-- Stützpunkte einklappbar (wie „Erweitert" im Geräte-Tab): der Header zeigt nur die
                                                     Anzahl, der Graph oben bleibt die primäre Editierfläche. Die ⚠-Warnung steht bewusst
                                                     außerhalb des Collapse → ein sicherheitsrelevanter Hinweis wird nie versteckt. -->
                                                <!-- No Spacing on this panel: the gaps below the header live as Margins, so the one in
                                                     front of the Collapsible expands with it instead of snapping in when it opens. -->
                                                <StackPanel>
                                                    <ToggleButton Classes="advHeader" IsChecked="{Binding ShowPoints}" Margin="0,4,0,0"
                                                                  ToolTip.Tip="{l:Tr MainWindow.PointsToggleTooltip}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding PointsLabel}"
                                                                       Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                                            <PathIcon Grid.Column="1" Classes="chevron" Data="{StaticResource IconChevronDown}"
                                                                      Width="11" Height="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ToggleButton>
                                                    <TextBlock IsVisible="{Binding HasDecreasingPercent}" Foreground="{DynamicResource WarningText}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                                                               Text="{l:Tr MainWindow.DecreasingPercentWarning}" />
                                                    <ctrl:Collapsible IsOpen="{Binding ShowPoints}">
                                                    <Border Classes="pointList" Margin="0,14,0,0">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="28,120,26,120,*" Margin="0,0,0,2">
                                                                <TextBlock Grid.Column="1" Text="{l:Tr MainWindow.PointTemperature}"
                                                                           Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="10,0,0,0" />
                                                                <TextBlock Grid.Column="3" Text="{l:Tr MainWindow.PointPercent}"
                                                                           Foreground="{DynamicResource TextFaint}" FontSize="11" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Points}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Spacing="6" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="c:PointRow">
                                                                        <Grid ColumnDefinitions="28,120,26,120,*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="{Binding Number, StringFormat='{}{0}.'}"
                                                                                       Foreground="{DynamicResource TextFaint}" FontSize="12"
                                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                            <NumericUpDown Grid.Column="1" Theme="{StaticResource Stepper}" Value="{Binding Temperature}"
                                                                                           Minimum="0" Maximum="120" Increment="1" InnerRightContent="°C"
                                                                                           AutomationProperties.Name="{Binding TemperatureName}"
                                                                                           ToolTip.Tip="{l:Tr MainWindow.PointTempTooltip}" />
                                                                            <PathIcon Grid.Column="2" Classes="pointArrow" Data="{StaticResource IconChevronDown}"
                                                                                      Width="14" Height="14" Foreground="{DynamicResource TextFaint}"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <NumericUpDown Grid.Column="3" Theme="{StaticResource Stepper}" Value="{Binding Percent}"
                                                                                           Minimum="0" Maximum="100" Increment="1" InnerRightContent="%"
                                                                                           AutomationProperties.Name="{Binding PercentName}"
                                                                                           ToolTip.Tip="{l:Tr MainWindow.PointPercentTooltip}" />
                                                                            <!-- Off at the last point: a curve keeps at least one (Delete in the chart
                                                                                 runs the same command). -->
                                                                            <Button Grid.Column="5" Classes="iconBtn" Command="{Binding RemoveCommand}"
                                                                                    AutomationProperties.Name="{Binding RemoveName}"
                                                                                    ToolTip.Tip="{l:Tr MainWindow.RemovePointTooltip}">
                                                                                <PathIcon Data="{StaticResource IconDelete}" Width="15" Height="15" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Command="{Binding AddPointCommand}" HorizontalAlignment="Left" Padding="8,3" FontSize="12"
                                                                    Margin="0,4,0,0" ToolTip.Tip="{l:Tr MainWindow.AddPointTooltip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                    <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
                                                                    <TextBlock Text="{l:Tr MainWindow.AddPoint}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                    </ctrl:Collapsible>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>

                            <Border Classes="card" Background="Transparent">
                                <StackPanel Spacing="{StaticResource SpacingSm}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                        <PathIcon Data="{StaticResource IconFan}" Width="14" Height="14"
                                                  Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:Tr MainWindow.FansOfCurve}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap">
                                        <Run Text="{l:Tr MainWindow.FansOfCurveSubtitle}" /><Run Text=" · " /><Run Text="{Binding Editor.SelectedCurveFanCount}" />
                                    </TextBlock>
                                    <!-- Blocks side by side, as many as the width takes, stretched to fill it (a WrapPanel with ItemWidth
                                         left up to a block's width empty at the right). Only fans a curve can drive (plus any already
                                         following this one); a fan in another curve says so - one curve per fan, ticking moves it. -->
                                    <ItemsControl Name="CurveFanBlocks" ItemsSource="{Binding Editor.SelectedCurveFanGroups}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ctrl:AutoFillGrid MinItemWidth="250" Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="c:FanCheckGroup">
                                                <Border Classes="fanBlock" Classes.assigned="{Binding AnyAssigned}" VerticalAlignment="Top">
                                                    <StackPanel>
                                                        <Border Classes="fanBlockHeader">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <CheckBox Grid.Column="0" Classes="triState"
                                                                          IsChecked="{Binding AllState, Mode=OneWay}"
                                                                          Command="{Binding ToggleAllCommand}"
                                                                          AutomationProperties.Name="{Binding ToggleAllName}"
                                                                          ToolTip.Tip="{l:Tr MainWindow.FanBlockToggleTooltip}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="4,0,8,0"
                                                                           Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="12"
                                                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Fans}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="c:FanCurveCheck">
                                                                    <StackPanel Margin="0,1">
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding Assigned}"
                                                                                      Content="{Binding Fan.DisplayName}" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding Fan.LiveRpm}"
                                                                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                        </Grid>
                                                                        <Grid ColumnDefinitions="Auto,*" Margin="28,0,0,4" IsVisible="{Binding ShowMoveHint}">
                                                                            <PathIcon Grid.Column="0" Data="{StaticResource IconInfo}" Width="12" Height="12"
                                                                                      Foreground="{DynamicResource TextFaint}" VerticalAlignment="Top" Margin="0,1,6,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding MoveHint}" FontSize="11" TextWrapping="Wrap"
                                                                                       Foreground="{DynamicResource TextMuted}" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <!-- ===== Profil-Editor (zweite Seite derselben Fläche) ===== -->
                        <StackPanel Spacing="{StaticResource SpacingXl}"
                                    IsVisible="{Binding Editor.Pane, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Profile}">
                            <Border Classes="card" Background="Transparent">
                                <StackPanel Spacing="{StaticResource SpacingLg}">
                                    <!-- Header like the curve editor's: title, actions, state switch. The switch only turns
                                         on: exactly one profile always runs, an "off" would have no receiver - so it is off for
                                         the running profile. Unsaved changes do not lock it; the switch asks first (as everywhere). -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{l:Tr MainWindow.EditProfile}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpacingSm}"
                                                    VerticalAlignment="Center">
                                            <Button Padding="8,3" FontSize="11" Command="{Binding Editor.DuplicateProfileCommand}"
                                                    ToolTip.Tip="{l:Tr MainWindow.DuplicateProfileTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                    <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
                                                    <TextBlock Text="{l:Tr MainWindow.Duplicate}" />
                                                </StackPanel>
                                            </Button>
                                            <!-- Disabled for the running and for the last profile; the tooltip says why, hence ShowOnDisabled. -->
                                            <Button Name="ProfileDeleteButton" Classes="danger" Padding="8,3" FontSize="11"
                                                    Command="{Binding Editor.DeleteProfileCommand}"
                                                    ToolTip.Tip="{l:Tr MainWindow.DeleteProfileTooltip}" ToolTip.ShowOnDisabled="True">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                    <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12" />
                                                    <TextBlock Text="{l:Tr MainWindow.Delete}" />
                                                </StackPanel>
                                            </Button>
                                            <ToggleSwitch Name="ProfileActiveSwitch" MinWidth="0" Margin="10,0,0,0"
                                                          OnContent="{l:Tr MainWindow.ProfileActive}" OffContent="{l:Tr MainWindow.ProfileActive}"
                                                          IsChecked="{Binding Editor.SelectedProfileActive, Mode=TwoWay}"
                                                          IsEnabled="{Binding Editor.CanActivateSelectedProfile}"
                                                          ToolTip.Tip="{Binding Editor.ActivateProfileHint}" ToolTip.ShowOnDisabled="True" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="100,*">
                                        <TextBlock Grid.Column="0" Text="{l:Tr MainWindow.Name}" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1" Classes="ghost" Text="{Binding Editor.SelectedProfile.Name}"
                                                 FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Die Kurven des Profils in derselben Darstellung wie „Aktive Kurven" in der Übersicht. -->
                            <Border Classes="card" Background="Transparent">
                                <StackPanel Spacing="{StaticResource SpacingSm}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                        <PathIcon Data="{StaticResource IconChartLine}" Width="14" Height="14"
                                                  Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:Tr MainWindow.ProfileCurves}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Editor.Curves.Count, StringFormat='({0})'}"
                                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{l:Tr MainWindow.ProfileCurvesSubtitle}"
                                               Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Editor.Curves}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="c:CurveEditRow">
                                                <Border Classes="itemCard">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0" Spacing="{StaticResource SpacingXxs}" VerticalAlignment="Top">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}"
                                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock Text="{l:Tr MainWindow.CurveOffHardwareAuto}" Foreground="{DynamicResource TextFaint}"
                                                                           FontSize="11" VerticalAlignment="Center" IsVisible="{Binding !Enabled}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                <TextBlock Text="{Binding SourceSummary}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                                                <TextBlock Text="{Binding LiveTemperatureDisplay}" FontSize="12"
                                                                           ctrl:TemperatureColor.Value="{Binding LiveTemperature}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding AssignedFans}" Margin="0,4,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="c:FanAssignRow">
                                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}" Margin="0,1">
                                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondary}"
                                                                                       FontSize="12" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding LiveRpm}" Foreground="{DynamicResource TextFaint}"
                                                                                       FontSize="12" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Command="{Binding $parent[Window].((c:MainController)DataContext).Editor.EditCurveCommand}"
                                                                    CommandParameter="{Binding}" HorizontalAlignment="Left" FontSize="11"
                                                                    Padding="8,3" Margin="0,8,0,0"
                                                                    ToolTip.Tip="{l:Tr MainWindow.OpenCurveTooltip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                    <PathIcon Data="{StaticResource IconRename}" Width="12" Height="12" />
                                                                    <TextBlock Text="{l:Tr MainWindow.EditCurve}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource BgInset}"
                                                                Padding="4" Margin="12,0,0,0" VerticalAlignment="Top">
                                                            <ctrl:CurveChart Points="{Binding Points}" LiveTemperature="{Binding LiveTemperature}"
                                                                             InterpolationMode="{Binding InterpolationMode}" Evaluator="{Binding CurveEvaluator}"
                                                                             IsReadOnly="True" Width="300" Height="130" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </Panel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- ============ Tab 3: Einstellungen (the gear in the header) ============ -->
            <TabItem>
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                    <!-- The settings have no tab of their own: the heading says where one is. -->
                    <StackPanel Grid.Row="0" Name="SettingsHeading" Orientation="Horizontal" Spacing="{StaticResource SpacingSm}"
                                Margin="0,4,0,14">
                        <PathIcon Data="{StaticResource IconCog}" Width="18" Height="18" Foreground="{DynamicResource Accent}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr MainWindow.TabSettings}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextHeading}" VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="1" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="240,*">

                        <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,0,14,0">
                        <!-- Seitenmenü: gruppiert (Geräte/Anwendung); Auswahl steuert das rechte Panel. -->
                        <ListBox Grid.Row="0" Classes="navList barInset" Background="Transparent"
                                 ItemsSource="{Binding Settings.Sections}"
                                 SelectedItem="{Binding Settings.SelectedSectionItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="c:SettingsSectionItem">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Group}" IsVisible="{Binding IsFirstInGroup}"
                                                   Foreground="{DynamicResource TextFaint}" FontSize="11" FontWeight="SemiBold"
                                                   Margin="4,10,0,4" />
                                        <Border Classes="menuRow">
                                            <Grid ColumnDefinitions="Auto,Auto,*">
                                                <!-- Auswahl-Streifen: transparent, außer der Eintrag ist aktiv (Style oben). -->
                                                <Border Grid.Column="0" Classes="selBar" Width="3" Height="16" CornerRadius="{DynamicResource RadiusXxs}"
                                                        Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <PathIcon Grid.Column="1" Data="{Binding IconKey, Converter={x:Static lconv:ResourceKeyConverter.Instance}}"
                                                          Width="15" Height="15"
                                                          Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Version: selectable for bug reports, so the link is a button of its own next to it; the
                             service's line only while it runs another build. -->
                        <StackPanel Grid.Row="1" Margin="4,12,0,0" Spacing="{StaticResource SpacingXxs}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingXs}">
                                <SelectableTextBlock Grid.Column="0" Name="AppVersionText" Text="{Binding Version.AppLabel}" FontSize="11"
                                                     Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                                                     VerticalAlignment="Center" />
                                <Button Grid.Column="1" Name="RepositoryLink" Classes="iconBtn"
                                        Command="{Binding Version.OpenRepositoryCommand}"
                                        ToolTip.Tip="{l:Tr Settings.OpenRepository}"
                                        AutomationProperties.Name="{l:Tr Settings.OpenRepository}">
                                    <PathIcon Data="{StaticResource IconGitHub}" Width="14" Height="14"
                                              Foreground="{DynamicResource TextSecondary}" />
                                </Button>
                            </Grid>
                            <Grid Name="ServiceVersionMismatch" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingXs}"
                                  IsVisible="{Binding Version.ShowServiceMismatch}"
                                  ToolTip.Tip="{l:Tr Settings.VersionMismatchTooltip}">
                                <PathIcon Grid.Column="0" Data="{StaticResource IconAlertCircle}" Width="12" Height="12"
                                          Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Version.ServiceMismatchText}" FontSize="11"
                                                     Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                        </Grid>

                        <!-- Rechter Innenabstand, damit die Scrollleiste nicht die Filter-Checkbox überlappt (Clipping). -->
                        <!-- Kept on a Border, not as ScrollViewer.Padding: the scroll presenter measures its content without
                             that padding but arranges it inside, so anything that fills the width (wrapping text) came out wider
                             than the viewport and lost its right edge. -->
                        <ScrollViewer Grid.Column="1" Classes="barInset">
                            <Border Padding="0,0,14,0">
                            <Panel>

                                <!-- ===== Sensoren ===== -->
                                <StackPanel Spacing="{StaticResource SpacingLg}"
                                            IsVisible="{Binding Settings.SelectedSection, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Sensors}">
                                    <Border Classes="card" IsVisible="{Binding ShowDeviceLoading}">
                                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap"
                                                   Text="{Binding DeviceLoadingText}" />
                                    </Border>
                                    <Border Classes="card" IsVisible="{Binding ShowNoDevices}">
                                        <TextBlock Foreground="{DynamicResource TextFaint}" FontSize="13" TextWrapping="Wrap"
                                                   Text="{l:Tr MainWindow.NoDevices}" />
                                    </Border>

                                    <!-- Überschrift + Suche/Filter auf dem Hintergrund (wie die übrigen Sektionen); die Liste darunter in der Card. -->
                                    <StackPanel Spacing="{StaticResource SpacingXxs}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                            <TextBlock Text="{l:Tr MainWindow.TemperatureSensors}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                            <TextBlock Text="{Binding Editor.FilteredSensors.Count, StringFormat='({0})'}" Foreground="{DynamicResource TextFaint}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{l:Tr MainWindow.SensorListSubtitle}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFaint}" FontSize="12" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                                        <!-- Search: the hits while searching, × and Esc clear it. -->
                                        <Border Classes="searchBox" Grid.Column="0">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <PathIcon Grid.Column="0" Classes="searchIcon" Data="{StaticResource IconSearch}" />
                                                <TextBox Grid.Column="1" x:Name="SensorSearchBox" Classes="searchField"
                                                         Text="{Binding Editor.SensorSearch, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="{l:Tr MainWindow.SearchPlaceholder}"
                                                         AutomationProperties.Name="{l:Tr MainWindow.SearchSensors}">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Escape" Command="{Binding Editor.ClearSensorSearchCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <TextBlock Grid.Column="2" Classes="searchHits" Text="{Binding Editor.SensorHitsText}"
                                                           IsVisible="{Binding Editor.IsSearchingSensors}" />
                                                <Button Grid.Column="3" Classes="iconBtn" Command="{Binding Editor.ClearSensorSearchCommand}"
                                                        IsVisible="{Binding Editor.IsSearchingSensors}"
                                                        ToolTip.Tip="{l:Tr MainWindow.ClearSearchTooltip}" AutomationProperties.Name="{l:Tr MainWindow.ClearSearch}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Editor.ShowHiddenSensors}" IsEnabled="{Binding Editor.CanToggleHiddenSensors}"
                                                  Content="{Binding Editor.ShowHiddenSensorsLabel}" VerticalAlignment="Center"
                                                  ToolTip.Tip="{l:Tr MainWindow.ShowHiddenSensorsTooltip}" ToolTip.ShowOnDisabled="True" />
                                    </Grid>

                                    <!-- Group actions. Below the search instead of beside it: at the minimum width the row would
                                         squeeze the search field to nothing. -->
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                        <Button Name="AutoGroupButton" Command="{Binding Editor.AutoGroupSensorsCommand}"
                                                ToolTip.Tip="{Binding Editor.AutoGroupTooltip}" ToolTip.ShowOnDisabled="True"
                                                AutomationProperties.Name="{l:Tr MainWindow.AutoGroup}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <PathIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" />
                                                <TextBlock Text="{l:Tr MainWindow.AutoGroup}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Name="NewGroupButton" Command="{Binding Editor.AddSensorGroupCommand}"
                                                ToolTip.Tip="{l:Tr MainWindow.NewGroupTooltip}"
                                                AutomationProperties.Name="{l:Tr MainWindow.NewGroup}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                                                <TextBlock Text="{l:Tr MainWindow.NewGroup}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Bulk bar while sensors are ticked: move them all, or clear the selection. -->
                                    <Border Name="SensorBulkBar" Classes="bulkBar" IsVisible="{Binding Editor.HasSensorSelection}">
                                        <!-- The actions wrap below the count when the window is narrow; "clear" stays on the right. -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                                            <WrapPanel Grid.Column="0" ItemSpacing="12" LineSpacing="8">
                                                <TextBlock Text="{Binding Editor.SensorSelectionText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Button Name="SensorBulkMoveButton" Padding="10,4" AutomationProperties.Name="{l:Tr MainWindow.MoveTo}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                        <TextBlock Text="{l:Tr MainWindow.MoveTo}" />
                                                        <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="choiceMenu"
                                                                    ItemsSource="{Binding Editor.BulkMoveMenu}"
                                                                    ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                                                    </Button.Flyout>
                                                </Button>
                                            </WrapPanel>
                                            <Button Grid.Column="1" Classes="iconBtn" VerticalAlignment="Top"
                                                    Command="{Binding Editor.ClearSensorSelectionCommand}"
                                                    AutomationProperties.Name="{l:Tr MainWindow.ClearSelection}">
                                                <TextBlock Text="{l:Tr MainWindow.ClearSelection}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- One section per group (configured order, "Ungrouped" last). A section is a drop target for
                                         rows dragged at their grip (code-behind); everything else runs through commands. -->
                                    <ItemsControl Name="SensorGroupList" ItemsSource="{Binding Editor.SensorGroupSections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="14" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="c:SensorGroupSection">
                                                <Border Classes="groupSection" Classes.highlight="{Binding IsHighlighted}"
                                                        DragDrop.AllowDrop="True">
                                                    <StackPanel>
                                                        <Border Classes="groupHeader">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpacingXs}">
                                                                <!-- OneWay + command: a click selects all unless all are selected (then clears). -->
                                                                <CheckBox Grid.Column="0" Classes="triState"
                                                                          IsChecked="{Binding AllSelected, Mode=OneWay}"
                                                                          Command="{Binding ToggleSelectAllCommand}"
                                                                          ToolTip.Tip="{l:Tr MainWindow.GroupSelectAllTooltip}"
                                                                          AutomationProperties.Name="{Binding SelectAllName}" />
                                                                <!-- Renamed in place; committed on Enter or when the focus leaves (code-behind), so
                                                                     the duplicate warning can follow every keystroke before anything merges. -->
                                                                <TextBox Grid.Column="1" Classes="ghost" Name="GroupNameBox"
                                                                         Text="{Binding DraftName}" IsVisible="{Binding !IsUngrouped}"
                                                                         PlaceholderText="{l:Tr MainWindow.GroupNamePlaceholder}"
                                                                         MaxLength="{Binding MaxNameLength}"
                                                                         FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}"
                                                                         VerticalAlignment="Center" LostFocus="OnGroupNameLostFocus"
                                                                         ToolTip.Tip="{l:Tr MainWindow.GroupNameTooltip}"
                                                                         AutomationProperties.Name="{l:Tr MainWindow.GroupNamePlaceholder}">
                                                                    <TextBox.KeyBindings>
                                                                        <KeyBinding Gesture="Enter" Command="{Binding CommitNameCommand}" />
                                                                    </TextBox.KeyBindings>
                                                                </TextBox>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" IsVisible="{Binding IsUngrouped}"
                                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"
                                                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                <TextBlock Grid.Column="2" Text="{l:Tr MainWindow.GroupNameDuplicate}"
                                                                           IsVisible="{Binding IsDuplicateName}"
                                                                           Foreground="{DynamicResource WarningText}" FontSize="11" VerticalAlignment="Center"
                                                                           ToolTip.Tip="{l:Tr MainWindow.GroupNameDuplicateTooltip}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="{DynamicResource TextFaint}"
                                                                           FontSize="12" VerticalAlignment="Center" Margin="4,0" />
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" IsVisible="{Binding !IsUngrouped}">
                                                                    <Button Classes="iconBtn" Command="{Binding MoveUpCommand}"
                                                                            ToolTip.Tip="{l:Tr MainWindow.GroupMoveUpTooltip}"
                                                                            AutomationProperties.Name="{l:Tr MainWindow.GroupMoveUp}">
                                                                        <PathIcon Data="{StaticResource IconChevronUp}" Width="15" Height="15" />
                                                                    </Button>
                                                                    <Button Classes="iconBtn" Command="{Binding MoveDownCommand}"
                                                                            ToolTip.Tip="{l:Tr MainWindow.GroupMoveDownTooltip}"
                                                                            AutomationProperties.Name="{l:Tr MainWindow.GroupMoveDown}">
                                                                        <PathIcon Data="{StaticResource IconChevronDown}" Width="15" Height="15" />
                                                                    </Button>
                                                                    <Button Classes="iconBtn" Command="{Binding DeleteCommand}"
                                                                            ToolTip.Tip="{l:Tr MainWindow.GroupDeleteTooltip}"
                                                                            AutomationProperties.Name="{l:Tr MainWindow.GroupDelete}">
                                                                        <PathIcon Data="{StaticResource IconDelete}" Width="15" Height="15" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{l:Tr MainWindow.GroupEmptyHint}" IsVisible="{Binding IsEmpty}"
                                                                   Foreground="{DynamicResource TextFaint}" FontSize="12" TextWrapping="Wrap"
                                                                   Margin="12,14" />
                                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="c:SensorOption">
                                                                    <Border Classes="deviceRow" Classes.dragged="{Binding IsDragged}">
                                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                                            <Button Grid.Row="0" Grid.Column="0" Classes="grip"
                                                                                    ToolTip.Tip="{l:Tr MainWindow.SensorGripTooltip}">
                                                                                <PathIcon Data="{DynamicResource IconGrip}" />
                                                                            </Button>
                                                                            <CheckBox Grid.Row="0" Grid.Column="1" Classes="triState" Margin="2,0,8,0"
                                                                                      IsChecked="{Binding IsSelected}"
                                                                                      AutomationProperties.Name="{Binding SelectName}" />
                                                                            <!-- Placeholder = hardware label: an empty field, like the label itself, is saved as
                                                                                 no own name, so the label follows the hardware. -->
                                                                            <TextBox Grid.Row="0" Grid.Column="2" Classes="ghost" Text="{Binding Name}"
                                                                                     PlaceholderText="{Binding NamePlaceholder}" MaxLength="{Binding MaxNameLength}"
                                                                                     FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource SpacingXs}"
                                                                                        VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                <TextBlock Text="{Binding LiveValue}" Foreground="{DynamicResource TextSecondary}"
                                                                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                                                <Button Classes="iconBtn" Command="{Binding ResetNameCommand}"
                                                                                        IsVisible="{Binding CanResetName}"
                                                                                        ToolTip.Tip="{Binding ResetNameTooltip}"
                                                                                        AutomationProperties.Name="{Binding ResetNameTooltip}">
                                                                                    <PathIcon Data="{StaticResource IconRestore}" Width="14" Height="14"
                                                                                              Foreground="{DynamicResource TextSecondary}" />
                                                                                </Button>
                                                                                <Button Classes="iconBtn" Command="{Binding ToggleVisibleCommand}"
                                                                                        ToolTip.Tip="{l:Tr MainWindow.ToggleVisibleSensorTooltip}">
                                                                                    <Panel>
                                                                                        <PathIcon Data="{StaticResource IconEye}" Width="15" Height="15"
                                                                                                  Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding Visible}" />
                                                                                        <PathIcon Data="{StaticResource IconEyeOff}" Width="15" Height="15"
                                                                                                  Foreground="{DynamicResource TextFaintest}" IsVisible="{Binding !Visible}" />
                                                                                    </Panel>
                                                                                </Button>
                                                                            </StackPanel>
                                                                            <!-- Second line: hardware address, then the group menu. -->
                                                                            <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto"
                                                                                  ColumnSpacing="{StaticResource SpacingSm}" Margin="0,4,0,0">
                                                                                <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource TextFaintest}"
                                                                                           FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                                           ToolTip.Tip="{l:Tr MainWindow.HardwareAddressTooltip}" />
                                                                                <Button Grid.Column="1" Classes="chip" Name="SensorGroupChip"
                                                                                        ToolTip.Tip="{l:Tr MainWindow.GroupChipTooltip}"
                                                                                        AutomationProperties.Name="{Binding GroupChipName}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                                        <TextBlock Text="{l:Tr MainWindow.Group}" Foreground="{DynamicResource TextFaint}"
                                                                                                   FontSize="12" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="{Binding GroupLabel}" FontSize="12" MaxWidth="180"
                                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                        <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10"
                                                                                                  Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                    <Button.Flyout>
                                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="choiceMenu"
                                                                                                    ItemsSource="{Binding GroupMenu}"
                                                                                                    ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                                                                                    </Button.Flyout>
                                                                                </Button>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ===== Lüfter ===== -->
                                <StackPanel Spacing="{StaticResource SpacingLg}"
                                            IsVisible="{Binding Settings.SelectedSection, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Fans}">
                                    <Border Classes="card" IsVisible="{Binding ShowDeviceLoading}">
                                        <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap"
                                                   Text="{Binding DeviceLoadingText}" />
                                    </Border>
                                    <Border Classes="card" IsVisible="{Binding ShowNoDevices}">
                                        <TextBlock Foreground="{DynamicResource TextFaint}" FontSize="13" TextWrapping="Wrap"
                                                   Text="{l:Tr MainWindow.NoDevices}" />
                                    </Border>

                                    <!-- Überschrift + Suche/Filter auf dem Hintergrund (wie die übrigen Sektionen); die Liste darunter in der Card. -->
                                    <StackPanel Spacing="{StaticResource SpacingXxs}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                            <TextBlock Text="{l:Tr MainWindow.Fans}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                            <TextBlock Text="{Binding Editor.FilteredFans.Count, StringFormat='({0})'}" Foreground="{DynamicResource TextFaint}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{l:Tr MainWindow.FanListSubtitle}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFaint}" FontSize="12" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                                        <!-- Search: the hits while searching, × and Esc clear it. -->
                                        <Border Classes="searchBox" Grid.Column="0">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <PathIcon Grid.Column="0" Classes="searchIcon" Data="{StaticResource IconSearch}" />
                                                <TextBox Grid.Column="1" x:Name="FanSearchBox" Classes="searchField"
                                                         Text="{Binding Editor.FanSearch, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="{l:Tr MainWindow.SearchPlaceholder}"
                                                         AutomationProperties.Name="{l:Tr MainWindow.SearchFans}">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Escape" Command="{Binding Editor.ClearFanSearchCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <TextBlock Grid.Column="2" Classes="searchHits" Text="{Binding Editor.FanHitsText}"
                                                           IsVisible="{Binding Editor.IsSearchingFans}" />
                                                <Button Grid.Column="3" Classes="iconBtn" Command="{Binding Editor.ClearFanSearchCommand}"
                                                        IsVisible="{Binding Editor.IsSearchingFans}"
                                                        ToolTip.Tip="{l:Tr MainWindow.ClearSearchTooltip}" AutomationProperties.Name="{l:Tr MainWindow.ClearSearch}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Editor.ShowHiddenFans}" IsEnabled="{Binding Editor.CanToggleHiddenFans}"
                                                  Content="{Binding Editor.ShowHiddenFansLabel}" VerticalAlignment="Center"
                                                  ToolTip.Tip="{l:Tr MainWindow.ShowHiddenFansTooltip}" ToolTip.ShowOnDisabled="True" />
                                        <Button Grid.Column="2" Classes="quiet" Name="AirflowLinkButton" VerticalAlignment="Center"
                                                Command="{Binding Settings.OpenSectionCommand}" CommandParameter="{x:Static c:SettingsSection.Airflow}"
                                                ToolTip.Tip="{l:Tr MainWindow.ShowAirflowTooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                <PathIcon Data="{StaticResource IconWind}" Width="13" Height="13" />
                                                <TextBlock Text="{l:Tr MainWindow.ShowAirflow}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Bulk bar while fans are ticked: set their position, hide/show them, or clear the selection. -->
                                    <Border Name="FanBulkBar" Classes="bulkBar" IsVisible="{Binding Editor.HasFanSelection}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                                            <WrapPanel Grid.Column="0" ItemSpacing="12" LineSpacing="8">
                                                <TextBlock Text="{Binding Editor.FanSelectionText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Button Name="FanBulkPositionButton" Padding="10,4" AutomationProperties.Name="{l:Tr MainWindow.SetPosition}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                        <TextBlock Text="{l:Tr MainWindow.SetPosition}" />
                                                        <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="choiceMenu"
                                                                    ItemsSource="{Binding Editor.BulkPositionMenu}"
                                                                    ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Name="FanBulkVisibilityButton" Padding="10,4"
                                                        Command="{Binding Editor.ToggleSelectedFansVisibleCommand}"
                                                        AutomationProperties.Name="{Binding Editor.FanBulkVisibilityText}">
                                                    <TextBlock Text="{Binding Editor.FanBulkVisibilityText}" />
                                                </Button>
                                            </WrapPanel>
                                            <Button Grid.Column="1" Classes="iconBtn" VerticalAlignment="Top"
                                                    Command="{Binding Editor.ClearFanSelectionCommand}"
                                                    AutomationProperties.Name="{l:Tr MainWindow.ClearSelection}">
                                                <TextBlock Text="{l:Tr MainWindow.ClearSelection}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- One section per mounting position in use (coolers, intakes, exhausts, rest; "No position"
                                         last). Dropping rows dragged at their grip on a section sets its position (code-behind). -->
                                    <ItemsControl Name="FanLocationList" ItemsSource="{Binding Editor.FanLocationSections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="14" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="c:FanLocationSection">
                                                <Border Classes="groupSection" DragDrop.AllowDrop="True">
                                                    <StackPanel>
                                                        <Border Classes="groupHeader" MinHeight="45">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource SpacingSm}">
                                                                <CheckBox Grid.Column="0" Classes="triState"
                                                                          IsChecked="{Binding AllSelected, Mode=OneWay}"
                                                                          Command="{Binding ToggleSelectAllCommand}"
                                                                          ToolTip.Tip="{l:Tr MainWindow.FanSelectAllTooltip}"
                                                                          AutomationProperties.Name="{Binding SelectAllName}" />
                                                                <PathIcon Grid.Column="1" Classes="flow" Data="{StaticResource IconFan}"
                                                                          Classes.intake="{Binding IsIntake}" Classes.exhaust="{Binding IsExhaust}"
                                                                          Classes.internal="{Binding IsInternal}"
                                                                          VerticalAlignment="Center" ToolTip.Tip="{Binding FlowTooltip}" />
                                                                <TextBlock Grid.Column="2" Classes="positionName" Classes.unspecified="{Binding IsUnspecified}"
                                                                           Text="{Binding Name}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="{DynamicResource TextFaint}"
                                                                           FontSize="12" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="c:FanAssignRow">
                                                                <Border Classes="deviceRow" Classes.dragged="{Binding IsDragged}">
                                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                                                        <Button Grid.Row="0" Grid.Column="0" Classes="grip"
                                                                                ToolTip.Tip="{l:Tr MainWindow.FanGripTooltip}">
                                                                            <PathIcon Data="{DynamicResource IconGrip}" />
                                                                        </Button>
                                                                        <CheckBox Grid.Row="0" Grid.Column="1" Classes="triState" Margin="2,0,8,0"
                                                                                  IsChecked="{Binding IsSelected}"
                                                                                  AutomationProperties.Name="{Binding SelectName}" />
                                                                        <!-- Placeholder = „Lüfter N", what an empty field is saved as (as in the setup assistant);
                                                                             the hardware address stands below. -->
                                                                        <TextBox Grid.Row="0" Grid.Column="2" Classes="ghost" Text="{Binding Name}"
                                                                                 PlaceholderText="{Binding DefaultName}" MaxLength="{Binding MaxNameLength}"
                                                                                 FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource SpacingXs}"
                                                                                    VerticalAlignment="Center" Margin="10,0,0,0">
                                                                            <!-- Kalibrier-Status auf einen Blick (gleiches Bild wie im Onboarding):
                                                                                 Lüfter-Icon = läuft, Alert = fehlgeschlagen, Häkchen = bereits kalibriert. -->
                                                                            <PathIcon Data="{StaticResource IconFan}" Width="13" Height="13"
                                                                                      Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                                      IsVisible="{Binding IsCalibrating}"
                                                                                      ToolTip.Tip="{l:Tr MainWindow.CalibrationRunning}" />
                                                                            <PathIcon Data="{StaticResource IconAlertCircle}" Width="13" Height="13"
                                                                                      Foreground="{DynamicResource DangerAccent}" VerticalAlignment="Center"
                                                                                      IsVisible="{Binding CalibrationFailed}"
                                                                                      ToolTip.Tip="{l:Tr MainWindow.CalibrationFailed}" />
                                                                            <PathIcon Data="{StaticResource IconCheckCircle}" Width="13" Height="13"
                                                                                      Foreground="{DynamicResource Success}" VerticalAlignment="Center"
                                                                                      IsVisible="{Binding ShowsCalibratedBadge}"
                                                                                      ToolTip.Tip="{Binding CalibrationBadgeHint}" />
                                                                            <!-- The daemon finds the fan off its calibration: the warning takes the badge's place. -->
                                                                            <PathIcon Name="CalibrationMismatchBadge" Data="{StaticResource IconAlert}" Width="13" Height="13"
                                                                                      Foreground="{DynamicResource WarningText}" VerticalAlignment="Center"
                                                                                      IsVisible="{Binding HasCalibrationMismatch}"
                                                                                      ToolTip.Tip="{Binding CalibrationMismatchText}" />
                                                                            <TextBlock Text="{Binding LiveRpm}" Foreground="{DynamicResource TextSecondary}"
                                                                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                                            <Button Classes="iconBtn" Command="{Binding ToggleVisibleCommand}"
                                                                                    ToolTip.Tip="{l:Tr MainWindow.ToggleVisibleFanTooltip}">
                                                                                <Panel>
                                                                                    <PathIcon Data="{StaticResource IconEye}" Width="15" Height="15"
                                                                                              Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding Visible}" />
                                                                                    <PathIcon Data="{StaticResource IconEyeOff}" Width="15" Height="15"
                                                                                              Foreground="{DynamicResource TextFaintest}" IsVisible="{Binding !Visible}" />
                                                                                </Panel>
                                                                            </Button>
                                                                        </StackPanel>

                                                                        <!-- Second line: hardware address, then "Identify" (controllable fans only) and the
                                                                             position menu - the two chips wrap onto two lines when the window is narrow, so
                                                                             the address keeps its room; the identify status below. -->
                                                                        <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*"
                                                                              ColumnSpacing="{StaticResource SpacingSm}" Margin="0,4,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Grid.Column="0" Text="{Binding HardwareName}" Foreground="{DynamicResource TextFaintest}"
                                                                                       FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"
                                                                                       ToolTip.Tip="{l:Tr MainWindow.HardwareAddressTooltip}" />
                                                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6">
                                                                                <Button Classes="chip" Name="IdentifyChip" Command="{Binding IdentifyCommand}"
                                                                                        IsVisible="{Binding CanControl}"
                                                                                        ToolTip.Tip="{Binding IdentifyTooltip}" ToolTip.ShowOnDisabled="True"
                                                                                        AutomationProperties.Name="{l:Tr MainWindow.Identify}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                                        <PathIcon Data="{StaticResource IconFan}" Width="12" Height="12"
                                                                                                  Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="{l:Tr MainWindow.Identify}" FontSize="12" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <Button Classes="chip" Name="PositionChip"
                                                                                        ToolTip.Tip="{l:Tr MainWindow.PositionChipTooltip}"
                                                                                        AutomationProperties.Name="{Binding PositionChipName}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                                        <TextBlock Text="{l:Tr MainWindow.Position}" Foreground="{DynamicResource TextFaint}"
                                                                                                   FontSize="12" VerticalAlignment="Center" />
                                                                                        <TextBlock Text="{Binding LocationLabel}" FontSize="12" MaxWidth="200"
                                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                        <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10"
                                                                                                  Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                    <Button.Flyout>
                                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="choiceMenu"
                                                                                                    ItemsSource="{Binding PositionMenu}"
                                                                                                    ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                                                                                    </Button.Flyout>
                                                                                </Button>
                                                                            </WrapPanel>
                                                                        </Grid>
                                                                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding IdentifyProgress}"
                                                                                   Foreground="{DynamicResource InfoAccent}" FontSize="11" TextAlignment="Right"
                                                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                                                   IsVisible="{Binding IdentifyProgress, Converter={x:Static lconv:StringNotEmptyConverter.Instance}}" />

                                                                        <!-- "Advanced" across the full width: a flat expander header, then three titled blocks - power range,
                                                                             calibration & tach, test (range and test only for controllable fans). -->
                                                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,0,0">
                                                                            <ToggleButton Classes="advHeader" IsChecked="{Binding ShowAdvanced}"
                                                                                          ToolTip.Tip="{l:Tr MainWindow.AdvancedToggleTooltip}">
                                                                                <Grid ColumnDefinitions="*,Auto">
                                                                                    <TextBlock Grid.Column="0" Text="{l:Tr MainWindow.AdvancedHeader}"
                                                                                               Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                                                                    <PathIcon Grid.Column="1" Classes="chevron" Data="{StaticResource IconChevronDown}"
                                                                                              Width="11" Height="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </ToggleButton>
                                                                            <ctrl:Collapsible IsOpen="{Binding ShowAdvanced}">
                                                                            <StackPanel Spacing="{StaticResource SpacingLg}" Margin="0,8,0,0">

                                                                                <!-- Power range: one slider with two thumbs and the start point marked on it; the
                                                                                     steppers are its keyboard path. Raw PWM stays the truth, percent is display. -->
                                                                                <Border Classes="block" IsVisible="{Binding CanControl}">
                                                                                    <StackPanel Spacing="{StaticResource SpacingMd}">
                                                                                        <StackPanel Spacing="2">
                                                                                            <TextBlock Classes="blockTitle" Text="{l:Tr FanAssignRow.PowerRangeTitle}" />
                                                                                            <TextBlock Classes="blockSub" Text="{l:Tr FanAssignRow.PowerRangeDesc}" />
                                                                                        </StackPanel>
                                                                                        <ctrl:RangeSlider Minimum="0" Maximum="100" Margin="4,0"
                                                                                                          LowerValue="{Binding MinPercent}" UpperValue="{Binding MaxPercent}"
                                                                                                          Marker="{Binding StartMarker}" MarkerLabel="{Binding StartMarkerLabel}" />
                                                                                        <WrapPanel ItemSpacing="22" LineSpacing="8">
                                                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                                                                <TextBlock Text="{l:Tr MainWindow.Min}" Foreground="{DynamicResource TextMuted}" Width="30"
                                                                                                           VerticalAlignment="Center" ToolTip.Tip="{l:Tr MainWindow.MinTooltip}" />
                                                                                                <NumericUpDown Theme="{StaticResource Stepper}" Value="{Binding MinPercent}"
                                                                                                               Minimum="0" Maximum="{Binding MaxPercent}" Increment="1"
                                                                                                               InnerRightContent="%" Width="120"
                                                                                                               AutomationProperties.Name="{l:Tr MainWindow.Min}"
                                                                                                               ToolTip.Tip="{l:Tr MainWindow.MinTooltip}" />
                                                                                                <TextBlock Text="{Binding MinPwmText}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                                                           VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                                                                <TextBlock Text="{l:Tr MainWindow.Max}" Foreground="{DynamicResource TextMuted}" Width="30"
                                                                                                           VerticalAlignment="Center" ToolTip.Tip="{l:Tr MainWindow.MaxTooltip}" />
                                                                                                <NumericUpDown Theme="{StaticResource Stepper}" Value="{Binding MaxPercent}"
                                                                                                               Minimum="{Binding MaxFloorPercent}" Maximum="100" Increment="1"
                                                                                                               InnerRightContent="%" Width="120"
                                                                                                               AutomationProperties.Name="{l:Tr MainWindow.Max}"
                                                                                                               ToolTip.Tip="{l:Tr MainWindow.MaxTooltip}" />
                                                                                                <TextBlock Text="{Binding MaxPwmText}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                                                           VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                        </WrapPanel>
                                                                                        <!-- Min below the start point: the fan may stall there (Max cannot go below it). -->
                                                                                        <Grid Name="StartHint" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingSm}"
                                                                                              IsVisible="{Binding HasStartHint}">
                                                                                            <PathIcon Grid.Column="0" Data="{StaticResource IconAlert}" Width="13" Height="13"
                                                                                                      Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                                                                            <TextBlock Grid.Column="1" Text="{Binding StartHintText}" FontSize="12" TextWrapping="Wrap"
                                                                                                       Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                                                                            <Button Grid.Column="2" Command="{Binding RaiseToStartCommand}" Content="{Binding StartHintAction}"
                                                                                                    FontSize="12" Padding="8,3" MinHeight="0" VerticalAlignment="Center" />
                                                                                        </Grid>
                                                                                    </StackPanel>
                                                                                </Border>

                                                                                <!-- Calibration & tach: first the state, then the actions. While a run goes, its button
                                                                                     turns into "cancel" and carries the progress. -->
                                                                                <Border Classes="block">
                                                                                    <StackPanel Spacing="{StaticResource SpacingMd}">
                                                                                        <StackPanel Spacing="2">
                                                                                            <TextBlock Classes="blockTitle" Text="{l:Tr FanAssignRow.CalibrationTitle}" />
                                                                                            <TextBlock Classes="blockSub" Text="{l:Tr FanAssignRow.CalibrationDesc}" />
                                                                                        </StackPanel>
                                                                                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpacingLg}"
                                                                                              RowSpacing="{StaticResource SpacingSm}">
                                                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr MainWindow.Tachometer}"
                                                                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                                                            <WrapPanel Grid.Row="0" Grid.Column="1" ItemSpacing="10" LineSpacing="6">
                                                                                                <TextBlock Text="{Binding TachName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <ctrl:StatusChip Text="{Binding TachChipText}" Tone="{Binding TachChipTone}" />
                                                                                            </WrapPanel>
                                                                                            <!-- A read-only fan cannot be calibrated: no start point row for it. -->
                                                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr FanAssignRow.StartPoint}" IsVisible="{Binding CanControl}"
                                                                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                                                            <WrapPanel Grid.Row="1" Grid.Column="1" ItemSpacing="10" LineSpacing="6" IsVisible="{Binding CanControl}">
                                                                                                <TextBlock Text="{Binding StartText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                                <ctrl:StatusChip Text="{Binding CalibrationChipText}" Tone="{Binding CalibrationChipTone}" />
                                                                                            </WrapPanel>
                                                                                        </Grid>
                                                                                        <!-- The overview's calibration hint, here above the button that recalibrates. -->
                                                                                        <Grid Name="CalibrationMismatchHint" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}"
                                                                                              IsVisible="{Binding HasCalibrationMismatch}">
                                                                                            <PathIcon Grid.Column="0" Data="{StaticResource IconAlert}" Width="13" Height="13"
                                                                                                      Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                                                                            <TextBlock Grid.Column="1" Text="{Binding CalibrationMismatchText}" FontSize="12" TextWrapping="Wrap"
                                                                                                       Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                                                                                        </Grid>

                                                                                        <WrapPanel ItemSpacing="10" LineSpacing="8" IsVisible="{Binding CanControl}">
                                                                                            <Button Name="CalibrateButton" Command="{Binding CalibrateCommand}" IsVisible="{Binding !IsCalibrating}"
                                                                                                    ToolTip.Tip="{Binding CalibrateTooltip}" ToolTip.ShowOnDisabled="True">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                                                    <PathIcon Data="{StaticResource IconGauge}" Width="13" Height="13" />
                                                                                                    <TextBlock Text="{Binding CalibrateLabel}" />
                                                                                                </StackPanel>
                                                                                            </Button>
                                                                                            <Button Classes="progBtn" Command="{Binding CancelCalibrationCommand}" IsVisible="{Binding IsCalibrating}"
                                                                                                    ToolTip.Tip="{l:Tr FanAssignRow.CancelCalibrationTooltip}">
                                                                                                <StackPanel>
                                                                                                    <TextBlock Text="{Binding CancelCalibrationLabel}" />
                                                                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding CalibrationFanProgress}" />
                                                                                                </StackPanel>
                                                                                            </Button>
                                                                                            <Button Command="{Binding CoupleSensorCommand}" IsVisible="{Binding !IsTachMapping}"
                                                                                                    ToolTip.Tip="{Binding CoupleSensorTooltip}" ToolTip.ShowOnDisabled="True">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                                                    <PathIcon Data="{StaticResource IconWind}" Width="13" Height="13" />
                                                                                                    <TextBlock Text="{Binding CoupleLabel}" />
                                                                                                </StackPanel>
                                                                                            </Button>
                                                                                            <Button Classes="progBtn" Command="{Binding CancelCoupleSensorCommand}" IsVisible="{Binding IsTachMapping}"
                                                                                                    ToolTip.Tip="{l:Tr MainWindow.CancelCoupleTooltip}">
                                                                                                <StackPanel>
                                                                                                    <TextBlock Text="{l:Tr MainWindow.CancelCouple}" />
                                                                                                    <ProgressBar IsIndeterminate="True" />
                                                                                                </StackPanel>
                                                                                            </Button>
                                                                                            <!-- The outcome of the last run, held for a few seconds. -->
                                                                                            <ctrl:StatusChip IsVisible="{Binding HasCalibrationResult}" Text="{Binding CalibrationProgress}"
                                                                                                             Tone="{Binding CalibrationResultTone}" TextWrapping="Wrap" />
                                                                                            <ctrl:StatusChip IsVisible="{Binding HasTachMappingResult}" Text="{Binding TachMappingProgress}"
                                                                                                             Tone="{Binding TachMappingResultTone}" TextWrapping="Wrap" />
                                                                                        </WrapPanel>
                                                                                        <!-- Live detail of a running calibration (phase · pwm · RPM) or coupling (what it does to the fans). -->
                                                                                        <TextBlock Text="{Binding CalibrationProgress}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                                                   TextWrapping="Wrap" IsVisible="{Binding IsCalibrating}" />
                                                                                        <TextBlock Text="{Binding TachMappingProgress}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                                                   TextWrapping="Wrap" IsVisible="{Binding IsTachMapping}" />

                                                                                        <!-- Assign by hand: every speed sensor with its reading; one another fan holds is locked. -->
                                                                                        <StackPanel>
                                                                                            <ToggleButton Classes="advHeader" IsChecked="{Binding ShowTachChoices}" HorizontalAlignment="Left"
                                                                                                          ToolTip.Tip="{l:Tr MainWindow.TachometerTooltip}">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                    <TextBlock Text="{l:Tr FanAssignRow.AssignByHand}" Foreground="{DynamicResource TextMuted}"
                                                                                                               FontSize="12" VerticalAlignment="Center" />
                                                                                                    <PathIcon Classes="chevron" Data="{StaticResource IconChevronDown}" Width="11" Height="11"
                                                                                                              Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                                                </StackPanel>
                                                                                            </ToggleButton>
                                                                                            <ctrl:Collapsible IsOpen="{Binding ShowTachChoices}">
                                                                                                <ListBox Classes="choiceList" Margin="0,6,0,0" ItemsSource="{Binding TachChoices}" AutoScrollToSelectedItem="False"
                                                                                                         SelectedItem="{Binding SelectedTachChoice}"
                                                                                                         AutomationProperties.Name="{l:Tr MainWindow.Tachometer}">
                                                                                                    <ListBox.Styles>
                                                                                                        <Style Selector="ListBoxItem" x:DataType="c:TachChoice">
                                                                                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                                                                        </Style>
                                                                                                    </ListBox.Styles>
                                                                                                    <ListBox.ItemTemplate>
                                                                                                        <DataTemplate x:DataType="c:TachChoice">
                                                                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                                                                                                                <Ellipse Grid.Column="0" Classes="radio" />
                                                                                                                <TextBlock Grid.Column="1" Text="{Binding Option.Name}" VerticalAlignment="Center"
                                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                                <ctrl:StatusChip Grid.Column="2" Tone="Warn" Text="{Binding TakenText}" IsVisible="{Binding IsTaken}" />
                                                                                                                <ctrl:StatusChip Grid.Column="2" Tone="Muted" Text="{Binding AutoAtText}" IsVisible="{Binding HasAutoAt}" />
                                                                                                                <TextBlock Grid.Column="3" Text="{Binding Option.LiveRpm}" MinWidth="70" TextAlignment="Right"
                                                                                                                           FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                                                            </Grid>
                                                                                                        </DataTemplate>
                                                                                                    </ListBox.ItemTemplate>
                                                                                                </ListBox>
                                                                                            </ctrl:Collapsible>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Border>

                                                                                <!-- Test: curve or by hand, the live speed large beside it. Switching to manual starts at
                                                                                     the power the fan runs at; collapsing "Advanced" returns it (OnShowAdvancedChanged), so do
                                                                                     another section, leaving the settings and hiding to the tray (MainController). -->
                                                                                <Border Classes="block" IsVisible="{Binding CanControl}">
                                                                                    <StackPanel Spacing="{StaticResource SpacingMd}">
                                                                                        <StackPanel Spacing="2">
                                                                                            <TextBlock Classes="blockTitle" Text="{l:Tr FanAssignRow.TestTitle}" />
                                                                                            <TextBlock Classes="blockSub" Text="{l:Tr FanAssignRow.TestDesc}" />
                                                                                        </StackPanel>
                                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpacingXl}">
                                                                                            <ListBox Grid.Column="0" Name="TestModeSwitch" Classes="seg" SelectionMode="Single,AlwaysSelected" AutoScrollToSelectedItem="False"
                                                                                                     SelectedIndex="{Binding Manual.ModeIndex}" VerticalAlignment="Center"
                                                                                                     AutomationProperties.Name="{l:Tr FanAssignRow.TestMode}">
                                                                                                <ListBoxItem Content="{l:Tr FanAssignRow.TestCurve}" />
                                                                                                <ListBoxItem Content="{l:Tr FanAssignRow.TestManual}" />
                                                                                            </ListBox>
                                                                                            <Slider Grid.Column="1" Value="{Binding Manual.ShownPercent}" Minimum="0" Maximum="100"
                                                                                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                                                                    IsEnabled="{Binding Manual.IsActive}"
                                                                                                    AutomationProperties.Name="{l:Tr FanAssignRow.TestPower}" />
                                                                                            <TextBlock Grid.Column="2" Text="{Binding Manual.ShownPercentText}"
                                                                                                       Foreground="{DynamicResource TextSecondary}" MinWidth="44" TextAlignment="Right"
                                                                                                       VerticalAlignment="Center" />
                                                                                            <StackPanel Grid.Column="3" MinWidth="84" VerticalAlignment="Center">
                                                                                                <TextBlock Classes="testRpm" Classes.manual="{Binding Manual.IsActive}"
                                                                                                           Text="{Binding Manual.LiveRpmNumber}" HorizontalAlignment="Right" />
                                                                                                <TextBlock Text="{l:Tr FanAssignRow.RpmLive}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                                                           HorizontalAlignment="Right" />
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                        <TextBlock Text="{l:Tr FanAssignRow.TestFloorHint}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                                                   TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                </Border>

                                                                                <TextBlock Text="{Binding ReadOnlyNote}" FontSize="12" Foreground="{DynamicResource TextFaint}"
                                                                                           TextWrapping="Wrap" IsVisible="{Binding !CanControl}" />
                                                                            </StackPanel>
                                                                            </ctrl:Collapsible>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ===== Airflow: case schema, pressure balance, notices, proposal per profile, role curves ===== -->
                                <StackPanel Spacing="14"
                                            IsVisible="{Binding Settings.SelectedSection, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Airflow}">
                                    <StackPanel Spacing="{StaticResource SpacingXxs}">
                                        <TextBlock Text="{l:Tr Airflow.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                        <TextBlock Foreground="{DynamicResource TextFaint}" FontSize="12" TextWrapping="Wrap" Text="{l:Tr Airflow.Subtitle}" />
                                    </StackPanel>
                                    <Border Classes="card" IsVisible="{Binding !Editor.IsReady}">
                                        <TextBlock Foreground="{DynamicResource TextFaint}" FontSize="13" TextWrapping="Wrap"
                                                   Text="{l:Tr MainWindow.NoDevices}" />
                                    </Border>

                                    <StackPanel Spacing="14" IsVisible="{Binding Editor.IsReady}">
                                        <ctrl:FlexRow Spacing="14" RowSpacing="14">
                                            <!-- The case with every fan in its zone; a fan opens "Position wählen". -->
                                            <Border Classes="block" ctrl:FlexRow.Basis="460" ctrl:FlexRow.Grow="1.5" VerticalAlignment="Top">
                                                <StackPanel Spacing="{StaticResource SpacingMd}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Classes="blockTitle" Text="{l:Tr Airflow.CaseTitle}" />
                                                            <TextBlock Classes="blockSub" Text="{l:Tr Airflow.CaseSub}" />
                                                        </StackPanel>
                                                        <!-- The case type: which positions exist, the schema and whether a balance applies. -->
                                                        <Button Grid.Column="1" Classes="chip" Name="CaseTypeChip" VerticalAlignment="Top"
                                                                ToolTip.Tip="{l:Tr CaseType.ChipTooltip}" AutomationProperties.Name="{Binding Editor.CaseTypeChipName}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                                <TextBlock Text="{l:Tr CaseType.Chip}" FontSize="12" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Editor.CaseTypeLabel}" FontSize="12" VerticalAlignment="Center" />
                                                                <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10"
                                                                          Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="choiceMenu"
                                                                            ItemsSource="{Binding Editor.CaseTypeMenu}"
                                                                            ItemContainerTheme="{StaticResource DetailMenuItem}" />
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                    <ctrl:CaseSchemaView Zones="{Binding Editor.AirflowZones}" Tray="{Binding Editor.AirflowTray}" CaseHeight="400"
                                                                         CaseType="{Binding Editor.CaseType}" Caption="{Binding Editor.CaseCaption}"
                                                                         AutomationProperties.Name="{l:Tr Airflow.CaseName}" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel ctrl:FlexRow.Basis="300" ctrl:FlexRow.Grow="1" Spacing="14" VerticalAlignment="Top">
                                                <!-- Pressure balance: intake ↔ exhaust, its basis and the verdict. -->
                                                <Border Classes="block">
                                                    <StackPanel Spacing="{StaticResource SpacingMd}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Classes="blockTitle" Text="{l:Tr Airflow.BalanceTitle}" />
                                                            <ctrl:StatusChip Grid.Column="1" IsVisible="{Binding Editor.AirflowBalance.HasCaseFans}"
                                                                             Text="{Binding Editor.AirflowBalance.BasisText}" Tone="{Binding Editor.AirflowBalance.BasisTone}"
                                                                             ToolTip.Tip="{Binding Editor.AirflowBalance.BasisTooltip}" />
                                                        </Grid>
                                                        <StackPanel Spacing="4" IsVisible="{Binding Editor.AirflowBalance.HasCaseFans}">
                                                            <Grid ColumnDefinitions="*,*">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                                                    <Border Width="10" Height="10" CornerRadius="{DynamicResource RadiusXxs}" Background="{DynamicResource IntakeBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Editor.AirflowBalance.IntakeHead}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding Editor.AirflowBalance.ExhaustHead}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                                                    <Border Width="10" Height="10" CornerRadius="{DynamicResource RadiusXxs}" Background="{DynamicResource ExhaustBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <ctrl:PressureBar IntakePercent="{Binding Editor.AirflowBalance.IntakePercent}"
                                                                              AutomationProperties.Name="{Binding Editor.AirflowBalance.AutomationName}" />
                                                            <Grid ColumnDefinitions="*,*,*">
                                                                <TextBlock Grid.Column="0" Text="{l:Tr Airflow.ScaleNegative}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" />
                                                                <TextBlock Grid.Column="1" Text="{l:Tr Airflow.ScaleBalanced}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{l:Tr Airflow.ScalePositive}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*,*">
                                                                <TextBlock Grid.Column="0" Text="{Binding Editor.AirflowBalance.IntakeValue}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Editor.AirflowBalance.ExhaustValue}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                            <Ellipse Grid.Column="0" Classes="verdictDot" VerticalAlignment="Top" Margin="0,5,0,0"
                                                                     Classes.ok="{Binding Editor.AirflowBalance.VerdictTone, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Ok}"
                                                                     Classes.warn="{Binding Editor.AirflowBalance.VerdictTone, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Warn}" />
                                                            <TextBlock Grid.Column="1" Classes="verdict" Text="{Binding Editor.AirflowBalance.VerdictText}"
                                                                       Classes.warn="{Binding Editor.AirflowBalance.VerdictTone, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Warn}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Notices, each with the action that resolves it. -->
                                                <Border Classes="block" IsVisible="{Binding Editor.HasAirflowHints}"
                                                        AutomationProperties.Name="{l:Tr Airflow.HintsName}">
                                                    <ItemsControl ItemsSource="{Binding Editor.AirflowHints}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="10" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="c:AirflowHintRow">
                                                                <ctrl:FlexRow Spacing="10" RowSpacing="6">
                                                                    <Grid ctrl:FlexRow.Basis="200" ctrl:FlexRow.Grow="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                        <Panel Grid.Column="0" VerticalAlignment="Top" Margin="0,1,0,0">
                                                                            <PathIcon Data="{StaticResource IconAlert}" Width="14" Height="14"
                                                                                      Foreground="{DynamicResource Warning}" IsVisible="{Binding IsWarn}" />
                                                                            <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14"
                                                                                      Foreground="{DynamicResource InfoAccent}" IsVisible="{Binding !IsWarn}" />
                                                                        </Panel>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Button Content="{Binding ActionLabel}" Command="{Binding Action}" IsVisible="{Binding HasAction}"
                                                                            ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowOnDisabled="True"
                                                                            FontSize="12" Padding="8,3" MinHeight="0" VerticalAlignment="Top" />
                                                                </ctrl:FlexRow>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </ctrl:FlexRow>

                                        <!-- The proposal for one profile: only what changes, ticked rows go into that profile or a new one. -->
                                        <Border Classes="block" IsVisible="{Binding Editor.AirflowTarget, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <StackPanel Spacing="{StaticResource SpacingMd}">
                                                <ctrl:FlexRow Spacing="10" RowSpacing="6">
                                                    <TextBlock Classes="blockTitle" Text="{l:Tr Airflow.ProposalTitle}" VerticalAlignment="Center" />
                                                    <Button Classes="chip" Name="AirflowTargetChip" VerticalAlignment="Center"
                                                            ToolTip.Tip="{l:Tr Airflow.TargetTooltip}" AutomationProperties.Name="{l:Tr Airflow.TargetName}">
                                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                            <TextBlock Text="{Binding Editor.AirflowTargetName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10"
                                                                      Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="choiceMenu"
                                                                        ItemsSource="{Binding Editor.AirflowTargetMenu}"
                                                                        ItemContainerTheme="{StaticResource DetailMenuItem}" />
                                                        </Button.Flyout>
                                                    </Button>
                                                    <ctrl:StatusChip Tone="Ok" Text="{l:Tr Airflow.Running}" IsVisible="{Binding Editor.AirflowTargetIsRunning}" />
                                                    <ctrl:StatusChip Tone="Muted" Text="{l:Tr Airflow.NotActive}" IsVisible="{Binding !Editor.AirflowTargetIsRunning}" />
                                                    <TextBlock ctrl:FlexRow.Grow="1" Text="{Binding Editor.AirflowChangesText}" IsVisible="{Binding Editor.HasAirflowChanges}"
                                                               FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </ctrl:FlexRow>

                                                <!-- The changes, old struck through → new. -->
                                                <ItemsControl ItemsSource="{Binding Editor.AirflowChanges}" IsVisible="{Binding Editor.HasAirflowChanges}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="c:AirflowChangeRow">
                                                            <Border Classes="changeRow" Classes.off="{Binding !Apply}">
                                                                <ctrl:FlexRow Spacing="12" RowSpacing="4">
                                                                    <CheckBox IsChecked="{Binding Apply}" AutomationProperties.Name="{Binding AutomationName}"
                                                                              VerticalAlignment="Center" MinWidth="0" />
                                                                    <StackPanel ctrl:FlexRow.Basis="150" ctrl:FlexRow.Grow="1" Spacing="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FanName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <Ellipse Classes="dirDot" VerticalAlignment="Center"
                                                                                     Classes.dirIn="{Binding Direction, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Intake}"
                                                                                     Classes.dirOut="{Binding Direction, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Exhaust}"
                                                                                     Classes.dirInt="{Binding Direction, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Internal}" />
                                                                            <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource TextFaint}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FromText}" Classes.struck="{Binding Apply}" FontSize="12" />
                                                                        <TextBlock Text="→" FontSize="12" Foreground="{DynamicResource TextFaint}" />
                                                                        <TextBlock Text="{Binding ToText}" Classes="changeTo" Classes.struck="{Binding !Apply}" FontSize="12" />
                                                                        <ctrl:StatusChip Tone="Busy" Text="{l:Tr Airflow.New}" IsVisible="{Binding ShowNew}" />
                                                                        <ctrl:StatusChip Tone="Warn" Text="{l:Tr Airflow.CurveOff}" IsVisible="{Binding ShowCurveOff}"
                                                                                         ToolTip.Tip="{l:Tr Airflow.CurveOffTooltip}" />
                                                                    </StackPanel>
                                                                </ctrl:FlexRow>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Nothing to change: the target already follows the proposal. -->
                                                <ctrl:FlexRow Spacing="10" RowSpacing="6" IsVisible="{Binding !Editor.HasAirflowChanges}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Ellipse Classes="verdictDot ok" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Editor.AirflowFollowsText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Classes="quiet" Content="{l:Tr Airflow.OpenInEditor}" Command="{Binding Editor.OpenAirflowTargetCommand}"
                                                            FontSize="12" Padding="8,3" MinHeight="0" />
                                                </ctrl:FlexRow>

                                                <!-- The fans that stay as they are, folded. -->
                                                <StackPanel IsVisible="{Binding Editor.HasAirflowUnchanged}">
                                                    <ToggleButton Classes="advHeader" IsChecked="{Binding Editor.ShowAirflowUnchanged}" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Editor.AirflowUnchangedText}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                                            <PathIcon Classes="chevron" Data="{StaticResource IconChevronDown}" Width="11" Height="11"
                                                                      Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ctrl:Collapsible IsOpen="{Binding Editor.ShowAirflowUnchanged}">
                                                        <ItemsControl ItemsSource="{Binding Editor.AirflowUnchanged}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemSpacing="16" LineSpacing="2" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFaint}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ctrl:Collapsible>
                                                </StackPanel>

                                                <!-- Take the ticked changes over - into the target, or as a new profile. -->
                                                <StackPanel Spacing="{StaticResource SpacingSm}" IsVisible="{Binding Editor.HasAirflowChanges}">
                                                    <TextBlock Text="{Binding Editor.AirflowEmptiedText}" IsVisible="{Binding Editor.HasAirflowEmptied}"
                                                               FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" />
                                                    <WrapPanel ItemSpacing="10" LineSpacing="8">
                                                        <Button Classes="primary" Name="AirflowApplyButton" Content="{Binding Editor.AirflowApplyLabel}"
                                                                Command="{Binding Editor.ApplyAirflowToTargetCommand}"
                                                                ToolTip.Tip="{Binding Editor.AirflowApplyTooltip}" ToolTip.ShowOnDisabled="True" />
                                                        <Button Name="AirflowCreateButton" Content="{l:Tr Airflow.CreateProfile}"
                                                                Command="{Binding Editor.CreateAirflowProfileCommand}"
                                                                ToolTip.Tip="{Binding Editor.AirflowCreateTooltip}" ToolTip.ShowOnDisabled="True" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Editor.AirflowFootText}" FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Role curves: which curve each role gets, its sources and the fans on it. -->
                                        <Border Classes="block" IsVisible="{Binding Editor.AirflowTarget, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <StackPanel Spacing="{StaticResource SpacingMd}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="blockTitle" Text="{l:Tr Airflow.RolesTitle}" />
                                                    <TextBlock Classes="blockSub" Text="{l:Tr Airflow.RolesSub}" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Editor.AirflowRoles}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ctrl:AutoFillGrid MinItemWidth="230" Spacing="{StaticResource SpacingMd}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="c:AirflowRoleTile">
                                                            <Border Classes="roleTile" Classes.unused="{Binding IsUnused}">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                    <Border Grid.Column="0" Classes="miniCurve" VerticalAlignment="Top">
                                                                        <ctrl:MiniCurve Width="64" Height="36" Samples="{Binding Samples}"
                                                                                        DotTemperature="NaN" Stroke="{DynamicResource Accent}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <WrapPanel ItemSpacing="6" LineSpacing="2">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            <ctrl:StatusChip Text="{Binding StateText}" Tone="{Binding StateTone}" ToolTip.Tip="{Binding StateTooltip}" />
                                                                        </WrapPanel>
                                                                        <Button Classes="link" Content="{Binding CurveName}" Command="{Binding Open}"
                                                                                IsVisible="{Binding InProfile}" FontSize="12" HorizontalAlignment="Left" />
                                                                        <TextBlock Text="{Binding CurveName}" IsVisible="{Binding !InProfile}" FontSize="12"
                                                                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap">
                                                                            <Run Text="{Binding Who}" />
                                                                            <Run Text=" · " />
                                                                            <Run Text="{Binding Detail}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding FansText}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== Darstellung: theme as a preview grid, language ===== -->
                                <StackPanel Spacing="24"
                                            IsVisible="{Binding Settings.SelectedSection, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Appearance}">
                                    <StackPanel Spacing="{StaticResource SpacingXxs}">
                                        <TextBlock Text="{l:Tr Settings.SectionAppearance}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                        <TextBlock Text="{l:Tr Settings.AppearanceDesc}" FontSize="12" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="{StaticResource SpacingMd}">
                                        <TextBlock Text="{l:Tr Header.Theme}" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                        <!-- One selection, so a list box: arrow keys, Home and End move it (the grid panel is navigable).
                                             More themes would simply be more tiles. No width limit: the grid takes as many tiles
                                             per row as the page has room for and leaves the rest of the row empty, so the
                                             tiles start at the left edge like the sections below (a MaxWidth on a stretched
                                             control centres it). -->
                                        <ListBox Name="ThemeGrid" Classes="themeGrid"
                                                 SelectionMode="Single,AlwaysSelected" WrapSelection="True"
                                                 ItemsSource="{Binding Settings.ThemeOptions}"
                                                 SelectedItem="{Binding Settings.SelectedThemeOption}"
                                                 AutomationProperties.Name="{l:Tr Settings.ThemeGroupName}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ctrl:AutoFillGrid MinItemWidth="210" Spacing="{StaticResource SpacingLg}" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="c:ThemeOption">
                                                    <StackPanel Spacing="{StaticResource SpacingMd}" ToolTip.Tip="{Binding Hint}">
                                                        <!-- The previews draw with the real tokens of each variant (no copied colours);
                                                             "System" shows light and dark side by side. -->
                                                        <Border Classes="themePreview">
                                                            <UniformGrid Rows="1">
                                                                <ThemeVariantScope RequestedThemeVariant="Light" IsVisible="{Binding ShowsLight}">
                                                                    <ContentControl ContentTemplate="{StaticResource ThemePreviewPane}" Content="{Binding}" />
                                                                </ThemeVariantScope>
                                                                <ThemeVariantScope RequestedThemeVariant="Dark" IsVisible="{Binding ShowsDark}">
                                                                    <ContentControl ContentTemplate="{StaticResource ThemePreviewPane}" Content="{Binding}" />
                                                                </ThemeVariantScope>
                                                                <ThemeVariantScope RequestedThemeVariant="{x:Static svc:ThemeVariantMap.Terminal}"
                                                                                   IsVisible="{Binding ShowsTerminal}">
                                                                    <ContentControl ContentTemplate="{StaticResource ThemePreviewPane}" Content="{Binding}" />
                                                                </ThemeVariantScope>
                                                                <ThemeVariantScope RequestedThemeVariant="{x:Static svc:ThemeVariantMap.HighContrast}"
                                                                                   IsVisible="{Binding ShowsHighContrast}">
                                                                    <ContentControl ContentTemplate="{StaticResource ThemePreviewPane}" Content="{Binding}" />
                                                                </ThemeVariantScope>
                                                            </UniformGrid>
                                                        </Border>
                                                        <!-- A grid, not a horizontal stack: the texts get the tile's width, so a long
                                                             hint ends in an ellipsis instead of being cut off. -->
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpacingSm}" Margin="4,0,4,2">
                                                            <Panel Classes="themeRadio" VerticalAlignment="Center">
                                                                <Ellipse Classes="ring" />
                                                                <Ellipse Classes="dot" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <!-- Accent colour: the theme's own, a preset or an own colour - each dot already in the colour it
                                         takes in the theme on screen; the tiles above show every theme's variant. -->
                                    <StackPanel Spacing="{StaticResource SpacingMd}" MaxWidth="760" HorizontalAlignment="Left">
                                        <StackPanel Spacing="{StaticResource SpacingXxs}">
                                            <TextBlock Text="{l:Tr Settings.Accent}" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                            <TextBlock Text="{l:Tr Settings.AccentHint}" FontSize="12" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ListBox Name="AccentSwatches" Classes="accentSwatches"
                                                 SelectionMode="Single,AlwaysSelected" WrapSelection="True"
                                                 ItemsSource="{Binding Settings.AccentSwatches}"
                                                 SelectedItem="{Binding Settings.SelectedAccentSwatch}"
                                                 AutomationProperties.Name="{l:Tr Settings.Accent}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="c:AccentSwatch">
                                                    <StackPanel Spacing="{StaticResource SpacingXs}" ToolTip.Tip="{Binding Tooltip}">
                                                        <Panel Classes="swatch">
                                                            <Ellipse Classes="swatchRing" Stroke="{Binding Color, Converter={x:Static lconv:ColorToBrushConverter.Instance}}" />
                                                            <Ellipse Classes="swatchDot" Fill="{Binding Color, Converter={x:Static lconv:ColorToBrushConverter.Instance}}" />
                                                            <Ellipse Classes="swatchWheel" Classes.custom="{Binding IsCustom}" />
                                                        </Panel>
                                                        <TextBlock Classes="swatchName" Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Own colour: a hex value (six digits take effect at once, anything else keeps a red
                                             frame) and what it becomes in the theme on screen. -->
                                        <Border Classes="accentCustom" IsVisible="{Binding Settings.IsCustomAccent}">
                                            <WrapPanel ItemSpacing="12" LineSpacing="8">
                                                <Border Classes="hexField" Classes.invalid="{Binding Settings.AccentHexInvalid}"
                                                        ToolTip.Tip="{l:Tr Accent.HexHint}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                                        <Border Classes="hexSwatch" Background="{Binding Settings.AccentLineColor, Converter={x:Static lconv:ColorToBrushConverter.Instance}}" />
                                                        <TextBlock Text="{l:Tr Accent.Hex}" FontSize="12" Foreground="{DynamicResource TextFaint}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Classes="hexInput" Text="{Binding Settings.AccentHexText}"
                                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                                 AutomationProperties.Name="{l:Tr Accent.HexName}" />
                                                    </StackPanel>
                                                </Border>
                                                <WrapPanel ItemSpacing="6" LineSpacing="4" VerticalAlignment="Center">
                                                    <TextBlock Classes="accentDerived" Text="{Binding Settings.AccentDerivedText}" />
                                                    <Border Classes="derivedSwatch" Background="{Binding Settings.AccentLineColor, Converter={x:Static lconv:ColorToBrushConverter.Instance}}" />
                                                    <TextBlock Classes="accentDerived" Text="{Binding Settings.AccentLineHex}" />
                                                    <TextBlock Classes="accentDerived" Text="{l:Tr Accent.DerivedButtons}" />
                                                    <Border Classes="derivedSwatch" Background="{Binding Settings.AccentFillColor, Converter={x:Static lconv:ColorToBrushConverter.Instance}}" />
                                                    <TextBlock Classes="accentDerived" Text="{Binding Settings.AccentFillHex}" />
                                                    <ctrl:StatusChip Text="{l:Tr Accent.Adjusted}" Tone="Muted"
                                                                     IsVisible="{Binding Settings.AccentAdjusted}"
                                                                     ToolTip.Tip="{l:Tr Accent.AdjustedTooltip}" />
                                                </WrapPanel>
                                            </WrapPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}" IsVisible="{Binding Settings.HasAccentWarning}">
                                            <PathIcon Data="{StaticResource IconAlert}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0"
                                                      Foreground="{DynamicResource WarningText}" />
                                            <TextBlock Text="{Binding Settings.AccentWarning}" FontSize="12" TextWrapping="Wrap" MaxWidth="700"
                                                       Foreground="{DynamicResource WarningText}" />
                                        </StackPanel>

                                        <!-- Preview with the real building blocks, display only: not a tab stop, not clickable,
                                             not announced. -->
                                        <Border Classes="accentPreview" IsHitTestVisible="False" Focusable="False"
                                                AutomationProperties.AccessibilityView="Raw">
                                            <WrapPanel ItemSpacing="18" LineSpacing="12" VerticalAlignment="Center">
                                                <Button Classes="primary" Content="{l:Tr UnsavedBar.Apply}" IsTabStop="False" VerticalAlignment="Center" />
                                                <ToggleSwitch IsChecked="True" IsTabStop="False" OnContent="" OffContent="" MinWidth="0"
                                                              VerticalAlignment="Center" />
                                                <CheckBox IsChecked="True" Content="{l:Tr Accent.PreviewSelected}" IsTabStop="False"
                                                          VerticalAlignment="Center" />
                                                <Slider Value="60" Width="120" IsTabStop="False" VerticalAlignment="Center" />
                                                <TextBlock Text="{l:Tr Accent.PreviewLink}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Spacing="{StaticResource SpacingSm}">
                                        <TextBlock Text="{l:Tr Header.Language}" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                        <WrapPanel ItemSpacing="12" LineSpacing="8">
                                            <Button Classes="chip" Name="LanguageChip" Padding="10,5" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding Settings.LanguageChipName}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <PathIcon Data="{StaticResource IconGlobe}" Width="13" Height="13"
                                                              Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Settings.SelectedLanguageOption.Display}" FontSize="13" VerticalAlignment="Center" />
                                                    <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10"
                                                              Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="choiceMenu"
                                                                ItemsSource="{Binding Settings.LanguageMenu}"
                                                                ItemContainerTheme="{StaticResource DetailMenuItem}" />
                                                </Button.Flyout>
                                            </Button>
                                            <TextBlock Text="{l:Tr Settings.LanguageHint}" FontSize="12" Foreground="{DynamicResource TextFaint}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== Start & Hintergrund ===== -->
                                <StackPanel Spacing="{StaticResource SpacingLg}"
                                            IsVisible="{Binding Settings.SelectedSection, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Background}">
                                    <StackPanel Spacing="{StaticResource SpacingXxs}">
                                        <TextBlock Text="{l:Tr Settings.SectionBackground}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                        <TextBlock Text="{l:Tr Settings.BackgroundDesc}" FontSize="12" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding Settings.MinimizeToTray}" Content="{l:Tr Header.RunInBackground}"
                                              ToolTip.Tip="{l:Tr Header.RunInBackgroundTooltip}" />
                                    <CheckBox IsChecked="{Binding Settings.UpdateChecksEnabled}" Content="{l:Tr Settings.CheckForUpdates}"
                                              ToolTip.Tip="{l:Tr Settings.CheckForUpdatesTooltip}" />
                                </StackPanel>

                                <!-- ===== Backup & setup: one row per task, its actions on the right ===== -->
                                <StackPanel Spacing="{StaticResource SpacingLg}"
                                            IsVisible="{Binding Settings.SelectedSection, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Backup}">
                                    <StackPanel Spacing="{StaticResource SpacingXxs}">
                                        <TextBlock Text="{l:Tr Settings.SectionBackup}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextHeading}" />
                                        <TextBlock Text="{l:Tr Settings.BackupDesc}" FontSize="12" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{l:Tr Settings.ActionsOffline}" FontSize="12" Foreground="{DynamicResource TextFaint}"
                                               TextWrapping="Wrap" IsVisible="{Binding !Connected}" />

                                    <Border Classes="block">
                                        <ctrl:FlexRow Spacing="20" RowSpacing="12">
                                            <StackPanel ctrl:FlexRow.Basis="300" ctrl:FlexRow.Grow="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Classes="blockTitle" Text="{l:Tr Settings.BackupTitle}" />
                                                <TextBlock Classes="blockSub" Text="{l:Tr Settings.BackupRowDesc}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}" VerticalAlignment="Center">
                                                <Button Click="OnExportBackup" IsEnabled="{Binding Connected}" ToolTip.Tip="{l:Tr Settings.ExportTooltip}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                        <PathIcon Data="{StaticResource IconArchive}" Width="14" Height="14" />
                                                        <TextBlock Text="{l:Tr Settings.ExportButton}" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- Locked while an import or reset is on its way: a second one would void the first one's verdict. -->
                                                <Button Click="OnImportBackup" ToolTip.Tip="{l:Tr Settings.ImportTooltip}">
                                                    <Button.IsEnabled>
                                                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                            <Binding Path="Connected" />
                                                            <Binding Path="!Backup.IsBusy" />
                                                        </MultiBinding>
                                                    </Button.IsEnabled>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                        <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                                                        <TextBlock Text="{l:Tr Settings.ImportButton}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </ctrl:FlexRow>
                                    </Border>

                                    <Border Classes="block">
                                        <ctrl:FlexRow Spacing="20" RowSpacing="12">
                                            <StackPanel ctrl:FlexRow.Basis="300" ctrl:FlexRow.Grow="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Classes="blockTitle" Text="{l:Tr Settings.OnboardingTitle}" />
                                                <TextBlock Classes="blockSub" Text="{l:Tr Settings.OnboardingDesc}" />
                                            </StackPanel>
                                            <Button Command="{Binding StartOnboardingCommand}" IsEnabled="{Binding Connected}" VerticalAlignment="Center"
                                                    ToolTip.Tip="{l:Tr Settings.StartOnboardingTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                    <PathIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" />
                                                    <TextBlock Text="{l:Tr Settings.StartOnboarding}" />
                                                </StackPanel>
                                            </Button>
                                        </ctrl:FlexRow>
                                    </Border>

                                    <!-- Factory reset: a neutral card framed in red instead of a red area, so its text and the red
                                         button stay readable; "back up first" sits right next to it. -->
                                    <Border Classes="block danger">
                                        <ctrl:FlexRow Spacing="20" RowSpacing="12">
                                            <StackPanel ctrl:FlexRow.Basis="300" ctrl:FlexRow.Grow="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                    <PathIcon Data="{StaticResource IconAlert}" Width="15" Height="15"
                                                              Foreground="{DynamicResource DangerAccent}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="blockTitle" Text="{l:Tr Settings.Reset}" Foreground="{DynamicResource DangerAccent}" />
                                                </StackPanel>
                                                <TextBlock Classes="blockSub" Text="{l:Tr Settings.ResetDesc}" Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}" VerticalAlignment="Center">
                                                <Button Click="OnExportBackup" IsEnabled="{Binding Connected}" Content="{l:Tr Settings.BackupFirst}"
                                                        ToolTip.Tip="{l:Tr Settings.BackupFirstTooltip}" />
                                                <Button Classes="danger" Click="OnResetConfig">
                                                    <Button.IsEnabled>
                                                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                            <Binding Path="Connected" />
                                                            <Binding Path="!Backup.IsBusy" />
                                                        </MultiBinding>
                                                    </Button.IsEnabled>
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                        <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" />
                                                        <TextBlock Text="{l:Tr Settings.ResetButton}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </ctrl:FlexRow>
                                    </Border>
                                </StackPanel>

                            </Panel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Unsaved changes: floats at the bottom over the tab content instead of pushing it (the scrollers make
             room below their content meanwhile, see TabControl.unsaved). Undo/redo, discard everything (still
             confirmed, but Ctrl+Z brings it back) and apply - the only place for the latter two. -->
        <Border Grid.Row="2" Name="UnsavedBar" Classes="unsavedBar" ZIndex="90"
                IsVisible="{Binding Editor.HasUnsavedChanges}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMd}">
                <PathIcon Grid.Column="0" Data="{StaticResource IconAlertCircle}" Width="18" Height="18"
                          Foreground="{DynamicResource WarningText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr UnsavedBar.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    <!-- The summary is the live region: it is what changes while the bar stays open. -->
                    <TextBlock Name="UnsavedBarDetail" Text="{Binding Editor.UnsavedBarText}" FontSize="12"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource SpacingSm}" VerticalAlignment="Center">
                    <Button Name="UndoButton" Classes="iconBtn" Command="{Binding Editor.UndoCommand}"
                            ToolTip.Tip="{l:Tr UnsavedBar.Undo}" AutomationProperties.Name="{l:Tr UnsavedBar.Undo}">
                        <PathIcon Data="{StaticResource IconUndo}" Width="16" Height="16" />
                    </Button>
                    <Button Name="RedoButton" Classes="iconBtn" Command="{Binding Editor.RedoCommand}" Margin="0,0,4,0"
                            ToolTip.Tip="{l:Tr UnsavedBar.Redo}" AutomationProperties.Name="{l:Tr UnsavedBar.Redo}">
                        <PathIcon Data="{StaticResource IconRedo}" Width="16" Height="16" />
                    </Button>
                    <Button Name="DiscardAllButton" Click="OnRevertChanges" ToolTip.Tip="{l:Tr MainWindow.RevertTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                            <PathIcon Data="{StaticResource IconRestore}" Width="14" Height="14" />
                            <TextBlock Text="{l:Tr UnsavedBar.DiscardAll}" />
                        </StackPanel>
                    </Button>
                    <Button Name="ApplyButton" Classes="primary" Command="{Binding Editor.SaveCommand}"
                            ToolTip.Tip="{l:Tr MainWindow.ApplyChangesTooltip}" ToolTip.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                            <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" />
                            <TextBlock Text="{l:Tr UnsavedBar.Apply}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast overlay: top-right of the tab area, layout-neutral (it overlays the TabControl in the
             same grid row, so showing a toast never shifts the tab content). Deliberately not in the
             header row - it would cover the profile button. The StackPanel has no background -> its empty
             area is not hit-testable; only the toast cards themselves catch the pointer. -->
        <StackPanel Grid.Row="2" ZIndex="100" Width="360"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Spacing="{StaticResource SpacingSm}">

            <!-- An error the GUI caught and kept running after (MainController.ErrorNotice): stays until closed, names the
                 GUI log. First in the stack - it may explain whatever else looks odd. -->
            <Border Name="ErrorNoticeToast" Classes="toast danger"
                    IsVisible="{Binding ErrorNotice.Text, Converter={x:Static lconv:StringNotEmptyConverter.Instance}}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Column="0" Classes="toastStripe" Margin="0,0,10,0" />
                    <PathIcon Grid.Column="1" Classes="toastIcon" />
                    <StackPanel Grid.Column="2" Spacing="{StaticResource SpacingSm}" VerticalAlignment="Center">
                        <TextBlock Classes="toastText" Text="{Binding ErrorNotice.Text}"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <SelectableTextBlock Name="ErrorLogPathText" Text="{Binding ErrorLogPath}"
                                             FontFamily="{StaticResource MonoFontFamily}"
                                             FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="iconBtn" Command="{Binding ErrorNotice.DismissCommand}"
                            VerticalAlignment="Top" ToolTip.Tip="{l:Tr MainWindow.Close}">
                        <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Reconnected after "Reconnect" (fades out by itself). The lost connection itself is the offline
                 banner above the tabs. -->
            <Border Name="ReconnectedToast" Classes="toast"
                    IsVisible="{Binding Connection.Status.Text, Converter={x:Static lconv:StringNotEmptyConverter.Instance}}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Column="0" Classes="toastStripe" Margin="0,0,10,0" />
                    <PathIcon Grid.Column="1" Classes="toastIcon" />
                    <TextBlock Grid.Column="2" Classes="toastText" Text="{Binding Connection.Status.Text}"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="3" Classes="iconBtn" Command="{Binding Connection.Status.DismissCommand}"
                            VerticalAlignment="Top" ToolTip.Tip="{l:Tr MainWindow.Close}">
                        <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Calibration progress (live-bound card); X cancels/closes via the existing command. -->
            <Border Classes="toast" IsVisible="{Binding Calibration, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Column="0" Classes="toastStripe" Margin="0,0,10,0" />
                    <PathIcon Grid.Column="1" Classes="toastIcon" Data="{StaticResource IconGauge}" />
                    <ctrl:CalibrationCard Grid.Column="2" VerticalAlignment="Center"
                                          Headline="{Binding Calibration.Headline}"
                                          Detail="{Binding Calibration.Detail}"
                                          Progress="{Binding Calibration.Progress}"
                                          ShowProgress="{Binding Calibration.ShowProgress}" />
                    <Button Grid.Column="3" Classes="iconBtn" Command="{Binding CancelCalibrationCommand}"
                            VerticalAlignment="Top" ToolTip.Tip="{l:Tr MainWindow.Close}">
                        <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Update-Hinweis: rein additiv, nur bei neuerer Release sichtbar; „Öffnen" führt zur Release-Seite,
                 das X merkt sich die Version wie zuvor „Später" (eine neuere zeigt wieder). Opt-out in den Einstellungen. -->
            <Border Classes="toast" IsVisible="{Binding Update.UpdateAvailable}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Column="0" Classes="toastStripe" Margin="0,0,10,0" />
                    <PathIcon Grid.Column="1" Classes="toastIcon" Data="{StaticResource IconSparkle}" />
                    <StackPanel Grid.Column="2" Spacing="{StaticResource SpacingSm}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                            <TextBlock Classes="toastText" Text="{l:Tr MainWindow.UpdateAvailable}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            <TextBlock Classes="toastText" Text="{Binding Update.LatestVersion}"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Classes="primary" Content="{l:Tr MainWindow.UpdateOpen}" Command="{Binding Update.OpenReleaseCommand}"
                                Padding="10,3" FontSize="12" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="iconBtn" Command="{Binding Update.DismissCommand}"
                            VerticalAlignment="Top" ToolTip.Tip="{l:Tr MainWindow.UpdateDismiss}">
                        <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Editor status (transient: successes auto-hide, errors stay + turn red; after a delete or a profile
                 switch it carries „Rückgängig"). Icon and stripe follow Classes.danger and the status' icon kind - see the
                 toastIcon styles in Theme/Layout.axaml. -->
            <Border Name="EditorStatusToast" Classes="toast" Classes.danger="{Binding Editor.Status.IsError}"
                    IsVisible="{Binding Editor.Status.Text, Converter={x:Static lconv:StringNotEmptyConverter.Instance}}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Column="0" Classes="toastStripe" Margin="0,0,10,0" />
                    <PathIcon Grid.Column="1" Classes="toastIcon"
                              Classes.swap="{Binding Editor.Status.Icon, Converter={x:Static lconv:EnumMatchConverter.Instance}, ConverterParameter=Swap}" />
                    <StackPanel Grid.Column="2" Spacing="{StaticResource SpacingSm}" VerticalAlignment="Center">
                        <TextBlock Classes="toastText" Text="{Binding Editor.Status.Text}"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        <Button Name="StatusActionButton" IsVisible="{Binding Editor.Status.HasAction}"
                                Command="{Binding Editor.Status.ActionCommand}"
                                Padding="10,3" FontSize="12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                <PathIcon Data="{StaticResource IconUndo}" Width="12" Height="12" />
                                <TextBlock Text="{Binding Editor.Status.ActionLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="3" Classes="iconBtn" Command="{Binding Editor.Status.DismissCommand}"
                            VerticalAlignment="Top" ToolTip.Tip="{l:Tr MainWindow.Close}">
                        <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Backup/import/reset status (transient, same semantics as the editor status toast). -->
            <Border Classes="toast" Classes.danger="{Binding Backup.Status.IsError}"
                    IsVisible="{Binding Backup.Status.Text, Converter={x:Static lconv:StringNotEmptyConverter.Instance}}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Column="0" Classes="toastStripe" Margin="0,0,10,0" />
                    <PathIcon Grid.Column="1" Classes="toastIcon" />
                    <TextBlock Grid.Column="2" Classes="toastText" Text="{Binding Backup.Status.Text}"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="iconBtn" Command="{Binding Backup.Status.DismissCommand}"
                            VerticalAlignment="Top" ToolTip.Tip="{l:Tr MainWindow.Close}">
                        <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
