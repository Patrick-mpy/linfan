<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LinFan.Core\LinFan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- On upgrade: WindowsLhmBackend drops Intel's "… Distance to TjMax" sensors by that literal name
         (IsDistanceToTjMax) - check that LHM still names them so, or they come back as temperatures that fall as
         the core heats up. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinFan.Hardware.Windows.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
