<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Das Backend selbst plus das geteilte Conformance-Kit (abstrakte Suite + Fault-/Referenz-Fixtures).
    Bewusst NICHT LinFan.Core.Tests referenzieren - die Suite lebt eigenständig im Kit.
    Die Tests injizieren ein Fake-LHM in den internen Inject-Ctor und laufen daher auf JEDEM OS
    (kein Kernel-Treiber, keine Admin-Rechte).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\LinFan.Hardware.Windows\LinFan.Hardware.Windows.csproj" />
    <ProjectReference Include="..\LinFan.Conformance\LinFan.Conformance.csproj" />
  </ItemGroup>

</Project>
